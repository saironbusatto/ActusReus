-                probs = net->Probabilities(FeaturesV2(CollectObservationV2(botAI)));
-                top = *std::max_element(probs.begin(), probs.end());
-                lastTick = now;
-            }
-            // Most likely action x1.25, unlikely ones x0.8: the net breaks ties inside a priority band but can no
-            // longer reorder the hand-written priorities (the old x0.25..x1.75 range did, and lost fights)
-            return 0.8f + 0.45f * probs[it->second] / top;
+        std::vector<ActionBasket*> candidates;
+        std::vector<int> ids;
+        float top = 0.0f;
+        for (ActionBasket* basket : queue.Items())
+        {
+            if (!basket || !basket->getAction() || basket->getRelevance() >= ACTION_EMERGENCY)
+                continue;
+            std::string const& name = basket->getAction()->getName();
+            auto const it = net->index.find(name);
+            if (it == net->index.end() || IsRuleOwned(name))
+                continue;
+            candidates.push_back(basket);
+            ids.push_back(it->second);
+            top = std::max(top, basket->getRelevance());
         }
+        if (candidates.size() < 2)
+            return pick;  // nothing to choose between
 
-    private:
-        uint64 lastTick = 0;
-        std::vector<float> probs;
-        float top = 1.0f;
-    };
+        std::vector<float> const probs = net->Probabilities(FeaturesV2(CollectObservationV2(botAI)));
+        std::vector<float> w;
+        float sum = 0.0f;
+        for (int id : ids)
+            sum += w.emplace_back(probs[id]);
+        if (sum <= 0.0f)
+            return pick;
+        size_t const chosen = std::discrete_distribution<size_t>(w.begin(), w.end())(rng);
+        candidates[chosen]->setRelevance(top + 0.01f);
+        pick.action = candidates[chosen]->getAction()->getName();
+        pick.prob = w[chosen] / sum;
+        return pick;
