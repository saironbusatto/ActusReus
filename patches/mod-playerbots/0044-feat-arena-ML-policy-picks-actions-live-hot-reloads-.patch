+    // Before the engine pops its queue: on a Playerbots.ArenaMlControl share of ticks, sample one queued combat
+    // action from the net (only among non-emergency, non rule-owned actions the rules triggered this tick) and lift
+    // it just above the other candidates, so it runs unless it is impossible right now.
+    inline NetPickResult NetPick(PlayerbotAI* botAI, Queue& queue)
+    {
+        NetPickResult pick;
+        PolicyPtr const net = ActivePolicy(botAI->GetBot());
+        if (!net)
+            return pick;
+        float const control = MlPolicies::Instance().Settings()->control;
+        thread_local std::mt19937 rng{std::random_device{}()};
+        if (control <= 0.0f || std::uniform_real_distribution<float>(0.0f, 1.0f)(rng) >= control)
