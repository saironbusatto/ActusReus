diff --git a/src/Ai/Class/Rogue/RogueTriggers.cpp b/src/Ai/Class/Rogue/RogueTriggers.cpp
index dd76177b..4ae0f3fd 100644
--- a/src/Ai/Class/Rogue/RogueTriggers.cpp
+++ b/src/Ai/Class/Rogue/RogueTriggers.cpp
@@ -182,3 +182,38 @@ bool KidneyShotTrigger::IsActive()
 
     return SpellCanBeCastTrigger::IsActive();
 }
+
+// Shadow Dance opens a second stun window: in melee, enough energy for Cheap Shot + builders, target not stunned
+bool ShadowDanceOpenerTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!bot->InArena() || !target || !target->IsAlive() || !bot->IsWithinMeleeRange(target))
+        return false;
+
+    if (botAI->HasAura("stealth", bot) || target->HasUnitState(UNIT_STATE_STUNNED) ||
+        bot->GetPower(POWER_ENERGY) < 60 || target->GetDiminishing(DIMINISHING_OPENING_STUN) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("shadow dance", bot);
+}
+
+// Inside Shadow Dance, Cheap Shot works without stealth
+bool DanceCheapShotTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !botAI->HasAura("shadow dance", bot) || target->HasUnitState(UNIT_STATE_STUNNED))
+        return false;
+
+    return target->GetDiminishing(DIMINISHING_OPENING_STUN) < DIMINISHING_LEVEL_IMMUNE &&
+           botAI->CanCastSpell("cheap shot", target);
+}
+
+// Premeditation: 2 free combo points from stealth before the opener, so Kidney Shot comes right after Cheap Shot
+bool PremeditationTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !botAI->HasAura("stealth", bot) || !bot->IsWithinDistInMap(target, 20.0f))
+        return false;
+
+    return botAI->CanCastSpell("premeditation", target);
+}
