+#ifndef PLAYERBOTS_ARENAROUND_H
+#define PLAYERBOTS_ARENAROUND_H
+
+#include <fstream>
+#include <mutex>
+#include <unordered_map>
+
+#include "Config.h"
+#include "GameTime.h"
+
+// Synchronised arena rounds: when Playerbots.ArenaRoundFile names a file, its first token is the current round id
+// (written by ml/policy/rodada_sync.py). A bot arena team queues at most once per round id; when the file moves to
+// a new id every team may queue again. So all trios play one fight, wait while their fights are reviewed, and
+// queue together for the next round. No file (or an empty path) = bots queue as usual.
+namespace ai::arena
+{
+    class ArenaRound
+    {
+    public:
+        static ArenaRound& Instance()
+        {
+            static ArenaRound instance;
+            return instance;
+        }
+
+        // False while this team already queued in the current round
+        bool CanJoin(uint32 teamId)
+        {
+            std::lock_guard<std::mutex> guard(lock);
+            Refresh();
+            if (round.empty())
+                return true;
+            auto const it = joined.find(teamId);
+            return it == joined.end() || it->second != round;
+        }
+
+        // The team's group is formed and queueing: it waits for the next round id
+        void MarkJoined(uint32 teamId)
+        {
+            std::lock_guard<std::mutex> guard(lock);
+            if (!round.empty())
+                joined[teamId] = round;
+        }
+
+    private:
+        void Refresh()  // under lock; re-reads the file at most every 3 s
+        {
+            uint64 const now = GameTime::GetGameTimeMS().count();
+            if (now - lastCheck < 3000)
+                return;
+            lastCheck = now;
+            std::string const path = sConfigMgr->GetOption<std::string>("Playerbots.ArenaRoundFile", "");
+            if (path.empty())
+            {
+                round.clear();
+                return;
+            }
+            std::ifstream in(path);
+            std::string id;
+            round = (in >> id) ? id : "";
+        }
+
+        std::mutex lock;
+        uint64 lastCheck = 0;
+        std::string round;
+        std::unordered_map<uint32, std::string> joined;
+    };
+}
+
+#endif
