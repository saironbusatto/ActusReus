From f63661268eb6b84059aab28e72356ef8b55baebb Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Mon, 26 Oct 2026 12:20:45 -0300
Subject: [PATCH 53/54] fix: arena bots out of combat after the opening walk
 back into the fight

Hiding drops combat. Out of combat, an enemy behind a pillar keeps "no
possible targets" off while "attack enemy player" fails on line of sight,
so arena tactics never ran and warlocks and healers stood idle for 230-284 s
(R0196). A new "arena out of combat" trigger runs arena tactics after the
first 20 s: damage dealers walk to the nearest enemy, healers back to the
teammate lowest on health.

Claude-Session: https://claude.ai/code/session_01H3noneHhUz8RFkv88ToEQ9
---
 src/Ai/Base/Actions/BattleGroundTactics.cpp   | 18 +++++++++++++-----
 src/Ai/Base/Actions/BattleGroundTactics.h     |  2 ++
 src/Ai/Base/Strategy/BattlegroundStrategy.cpp |  2 ++
 src/Ai/Base/Trigger/PvpTriggers.cpp           |  8 ++++++++
 src/Ai/Base/Trigger/PvpTriggers.h             |  9 +++++++++
 src/Ai/Base/TriggerContext.h                  |  2 ++
 6 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/src/Ai/Base/Actions/BattleGroundTactics.cpp b/src/Ai/Base/Actions/BattleGroundTactics.cpp
index c4559006..15739436 100644
--- a/src/Ai/Base/Actions/BattleGroundTactics.cpp
+++ b/src/Ai/Base/Actions/BattleGroundTactics.cpp
@@ -4290,8 +4290,7 @@ bool ArenaTactics::dropToRingFloor(Battleground* bg)
     return true;
 }
 
-// Milliseconds since the arena gates opened
-static uint32 FightTime(Battleground* bg)
+uint32 ArenaTactics::FightTime(Battleground* bg)
 {
     uint32 const prep = sWorld->getIntConfig(CONFIG_ARENA_PREP_TIME) * IN_MILLISECONDS;
     return bg && bg->GetStartTime() > prep ? bg->GetStartTime() - prep : 0;
@@ -4366,11 +4365,20 @@ bool ArenaTactics::Execute(Event event)
         }
     }
 
-    // Out of combat after the opening: hiding behind pillars drops combat, and walking back to the centre spot left
-    // damage dealers idle for minutes (R0180: 533 s fight, a warlock out of combat looping firestone for 3 min)
-    if (!bot->IsInCombat() && (healer || FightTime(bg) < 20000))
+    if (!bot->IsInCombat() && FightTime(bg) < 20000)
         return moveToCenter(bg);
 
+    // Out of combat after the opening: hiding behind pillars drops combat, and walking back to the centre spot left
+    // bots idle for minutes (R0180: 533 s fight, a warlock looping firestone for 3 min). A healer walks back to the
+    // teammate who needs it most; a damage dealer (below) to the nearest enemy.
+    if (!bot->IsInCombat() && healer)
+    {
+        Unit* mate = coverAnchor();
+        if (!mate || (bot->IsWithinDistInMap(mate, 15.0f) && bot->IsWithinLOSInMap(mate)))
+            return true;
+        return MoveTo(mate->GetMapId(), mate->GetPositionX(), mate->GetPositionY(), mate->GetPositionZ(), false, true);
+    }
+
     // In combat (or out of it after the opening) with nobody in sight (behind a pillar or the bridge): standing still let two healers outlast each
     // other for up to 37 minutes, so a damage dealer walks to the nearest enemy it can detect
     if (sPlayerbotAIConfig.ArenaPvpStrategies && !healer && !target && !inCover)
