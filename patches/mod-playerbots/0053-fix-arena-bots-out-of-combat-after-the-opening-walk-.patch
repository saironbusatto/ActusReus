     static bool OffArenaFloor(Player* bot) { return InDalaranPipe(bot) || FloatingInRingOfValor(bot); }
     // Enemy casters and hunters within 40 yards that see the point; ignore = the melee target fought anyway.
     // shotAt is set when one of them is casting at the bot.
+    // Milliseconds since the arena gates opened
+    static uint32 FightTime(Battleground* bg);
     static uint8 Exposure(Player* bot, float x, float y, float z, Unit* ignore = nullptr, bool* shotAt = nullptr);
 
 private:
diff --git a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
index 07be83c0..1c35bf74 100644
--- a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
+++ b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
@@ -90,6 +90,8 @@ void ArenaStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
     triggers.push_back(new TriggerNode("off arena floor", { NextAction("arena tactics", ACTION_EMERGENCY + 6) }));
     // above heals and damage, below interrupts and CC (ACTION_INTERRUPT)
     triggers.push_back(new TriggerNode("exposed to enemy caster", { NextAction("arena tactics", ACTION_MOVE + 5) }));
+    // an enemy in sight but out of LoS keeps "no possible targets" off while "attack enemy player" fails on LoS
+    triggers.push_back(new TriggerNode("arena out of combat", { NextAction("arena tactics", ACTION_BG) }));
     triggers.push_back(new TriggerNode("cobalt frag bomb", { NextAction("cobalt frag bomb", ACTION_INTERRUPT + 3) }));
     triggers.push_back(new TriggerNode("hyperspeed accelerators", { NextAction("hyperspeed accelerators", ACTION_HIGH + 9) }));
     triggers.push_back(new TriggerNode("partner bursting", { NextAction("cc on cc target", ACTION_INTERRUPT + 2) }));
diff --git a/src/Ai/Base/Trigger/PvpTriggers.cpp b/src/Ai/Base/Trigger/PvpTriggers.cpp
index 748087b0..c41eecb7 100644
--- a/src/Ai/Base/Trigger/PvpTriggers.cpp
+++ b/src/Ai/Base/Trigger/PvpTriggers.cpp
@@ -71,6 +71,14 @@ bool ExposedToEnemyCasterTrigger::IsActive()
            ArenaTactics::Exposure(bot, bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ()) > 0;
 }
 
+bool ArenaOutOfCombatTrigger::IsActive()
+{
+    if (!sPlayerbotAIConfig.ArenaPvpStrategies || !bot->InArena() || !bot->IsAlive() || bot->IsInCombat())
+        return false;
+    Battleground* bg = bot->GetBattleground();
+    return bg && bg->GetStatus() == STATUS_IN_PROGRESS && ArenaTactics::FightTime(bg) >= 20000;
+}
+
 bool BgActiveTrigger::IsActive()
 {
     if (bot->InBattleground())
diff --git a/src/Ai/Base/Trigger/PvpTriggers.h b/src/Ai/Base/Trigger/PvpTriggers.h
