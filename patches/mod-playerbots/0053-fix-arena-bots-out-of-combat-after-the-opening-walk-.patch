 };
 
+// In an arena after the opening but out of combat (hiding drops it): ArenaTactics walks back into the fight
+class ArenaOutOfCombatTrigger : public Trigger
+{
+public:
+    ArenaOutOfCombatTrigger(PlayerbotAI* botAI) : Trigger(botAI, "arena out of combat", 1000) {}
+
+    bool IsActive() override;
+};
+
 class BgInviteActiveTrigger : public Trigger
 {
 public:
