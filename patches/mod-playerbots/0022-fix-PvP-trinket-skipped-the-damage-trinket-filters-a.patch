From c74a62bf536d94b6d5d11e7fe0af47e2fe9c0c34 Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Wed, 21 Oct 2026 20:02:56 -0300
Subject: [PATCH 22/44] fix: PvP trinket skipped the damage-trinket filters
 (aura/mana) that always rejected a CC break

---
 src/Ai/Base/Actions/GenericSpellActions.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/Ai/Base/Actions/GenericSpellActions.cpp b/src/Ai/Base/Actions/GenericSpellActions.cpp
index 316cc421..92a5cb7d 100644
--- a/src/Ai/Base/Actions/GenericSpellActions.cpp
+++ b/src/Ai/Base/Actions/GenericSpellActions.cpp
@@ -577,6 +577,11 @@ bool UseTrinketAction::UseTrinket(Item* item)
                 }
             }
 
+            // The CC break removes stun/fear (no aura, no mana): the damage-trinket filters below do not apply,
+            // and CanCastSpell would refuse it precisely because the bot is stunned
+            if (ccBreak)
+                break;
+
             SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
             if (!spellInfo || !spellInfo->IsPositive())
                 return false;
-- 
2.55.0

