-// Healer under caster pressure steps behind the nearest cover (pillar, tomb, crate) that still
-// keeps line of sight to its partner. Points are sampled on rings around the bot.
-bool ArenaTactics::hideFromCaster()
+static bool SeesPoint(Unit* from, float x, float y, float z)
 {
-    Unit* caster = ai::arena::FindEnemyCaster(botAI);
-    if (!caster || !caster->IsWithinLOSInMap(bot) || !bot->IsWithinDistInMap(caster, 40.0f))
-        return false;
+    float const eye = 2.0f;
+    return from->GetMap()->isInLineOfSight(from->GetPositionX(), from->GetPositionY(), from->GetPositionZ() + eye, x,
+                                           y, z + eye, from->GetPhaseMask(), LINEOFSIGHT_ALL_CHECKS,
+                                           VMAP::ModelIgnoreFlags::Nothing);
+}
+
+uint8 ArenaTactics::Exposure(Player* bot, float x, float y, float z, Unit* ignore, bool* shotAt)
+{
+    Battleground* bg = bot->GetBattleground();
+    if (!bg)
+        return 0;
+
+    uint8 seen = 0;
+    for (auto const& [guid, enemy] : bg->GetPlayers())  // at most 10 players in an arena
+    {
+        if (!enemy || enemy == ignore || !enemy->IsAlive() || enemy->IsSpectator() ||
+            enemy->GetBgTeamId() == bot->GetBgTeamId() || !PlayerbotAI::IsRanged(enemy, true) ||
+            PlayerbotAI::IsHeal(enemy, true) || enemy->GetExactDist(x, y, z) > 40.0f || !SeesPoint(enemy, x, y, z))
+            continue;
+
+        ++seen;
+        Spell* spell = enemy->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+        if (shotAt && spell && spell->m_targets.GetUnitTarget() == bot)
+            *shotAt = true;
+    }
+    return seen;
+}
+
+// Who must keep seeing the bot from its cover: the team's healer, or for a healer the teammate lowest on health
+Unit* ArenaTactics::coverAnchor()
+{
+    Group* group = bot->GetGroup();
+    if (!group)
+        return nullptr;
 
-    Spell* spell = caster->GetCurrentSpell(CURRENT_GENERIC_SPELL);
-    bool const castAtMe = spell && spell->m_targets.GetUnitTarget() == bot;
-    if (!castAtMe && bot->GetHealthPct() > 50.0f)
+    bool const healer = PlayerbotAI::IsHeal(bot);
+    Player* anchor = nullptr;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member == bot || !member->IsAlive() || member->GetMap() != bot->GetMap())
+            continue;
+
+        if (!healer && PlayerbotAI::IsHeal(member))
+            return member;
+        if (healer && (!anchor || member->GetHealthPct() < anchor->GetHealthPct()))
+            anchor = member;
+    }
+    return anchor;
+}
+
+// Out of the enemy casters' and hunters' sight, as players play the pillars, but where the own healer still sees the
+// bot (a healer: where it still sees the teammate who needs it most). A healer always hides; a ranged damage dealer,
+// who needs its own line of sight to deal damage, when shot at or below half health; a melee on its target circles it
+// to the side a pillar shields from the other casters.
+bool ArenaTactics::takeCover()
+{
+    uint32 const now = getMSTime();
+    if (!sPlayerbotAIConfig.ArenaPvpStrategies || now < coverUntil || now < nextCoverCheck)
         return false;
 
-    Unit* partner = ai::arena::FindPartner(botAI);
-    Map* map = bot->GetMap();
-    uint32 const phase = bot->GetPhaseMask();
-    float const eye = 2.0f;
+    bool const healer = PlayerbotAI::IsHeal(bot);
+    bool const melee = !healer && !PlayerbotAI::IsRanged(bot);
+    Unit* target = bot->GetVictim();
+    if (melee && (!target || !bot->IsWithinMeleeRange(target)))
+        return false;  // closing in stays with the chase; cover counts once on the target
 
-    // ponytail: 3 rings x 12 angles with one PathGenerator per candidate; use a cached cover map per arena if CPU shows up
-    for (float radius : {5.0f, 9.0f, 13.0f})
+    Unit* ignore = melee ? target : nullptr;
+    bool shotAt = false;
+    uint8 const exposed = Exposure(bot, bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ(), ignore, &shotAt);
+    if (!exposed || (!healer && !melee && !shotAt && bot->GetHealthPct() >= 50.0f))
+        return false;
+    if (bot->IsNonMeleeSpellCast(false) && !shotAt)
+        return false;  // let the heal or nuke land first
+
+    nextCoverCheck = now + 1500;
+    Unit* anchor = coverAnchor();
+    Unit* center = melee ? target : bot;
+    std::vector<float> const radii = melee ? std::vector<float>{2.5f} : std::vector<float>{5.0f, 9.0f, 13.0f};
+    uint8 best = exposed;
+    float bestX = 0.0f, bestY = 0.0f, bestZ = 0.0f;
+
+    // ponytail: up to 36 points x (shooters + anchor) LoS checks, paths only for improving points; throttled to
+    // 1.5 s per exposed bot. A cached cover map per arena if CPU shows up.
+    for (float radius : radii)
     {
-        for (int i = 0; i < 12; ++i)
+        for (int i = 0; i < 12 && best > 0; ++i)
         {
             float const angle = i * float(M_PI) / 6.0f;
-            float x = bot->GetPositionX() + radius * std::cos(angle);
-            float y = bot->GetPositionY() + radius * std::sin(angle);
-            float z = bot->GetPositionZ();
+            float x = center->GetPositionX() + radius * std::cos(angle);
+            float y = center->GetPositionY() + radius * std::sin(angle);
+            float z = center->GetPositionZ();
             bot->UpdateAllowedPositionZ(x, y, z);
 
-            if (map->isInLineOfSight(caster->GetPositionX(), caster->GetPositionY(), caster->GetPositionZ() + eye,
-                                     x, y, z + eye, phase, LINEOFSIGHT_ALL_CHECKS, VMAP::ModelIgnoreFlags::Nothing))
+            uint8 const seen = Exposure(bot, x, y, z, ignore);
+            if (seen >= best)
                 continue;
-
-            if (partner && !map->isInLineOfSight(partner->GetPositionX(), partner->GetPositionY(),
-                                                 partner->GetPositionZ() + eye, x, y, z + eye, phase,
-                                                 LINEOFSIGHT_ALL_CHECKS, VMAP::ModelIgnoreFlags::Nothing))
+            if (anchor && (anchor->GetExactDist(x, y, z) > 35.0f || !SeesPoint(anchor, x, y, z)))
                 continue;
 
             PathGenerator path(bot);
@@ -4435,12 +4502,22 @@ bool ArenaTactics::hideFromCaster()
             if (!(path.GetPathType() & PATHFIND_NORMAL))
                 continue;
 
-            if (castAtMe)
-                bot->CastStop();
-            return MoveTo(bot->GetMapId(), x, y, z, false, true);
+            best = seen;
+            bestX = x;
+            bestY = y;
+            bestZ = z;
         }
+        if (best == 0)
+            break;  // inner rings first: the shortest walk to full cover
     }
-    return false;
+
+    if (best == exposed)
+        return false;
+
+    if (shotAt)
+        bot->CastStop();
+    coverUntil = now + (melee ? 4000 : 3000);
+    return MoveTo(bot->GetMapId(), bestX, bestY, bestZ, false, true);
 }
 
