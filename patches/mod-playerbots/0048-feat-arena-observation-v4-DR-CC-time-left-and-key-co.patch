+
+    // v4 (199 values): each slot = its 25 v2 values + DR stun/fear/incap/silence (/3), CC left (/8 s, capped),
+    // interrupt/CC/defensive ready; kill window last. Same order as ml/policy/features.py features_v4.
+    inline std::vector<float> FeaturesV4(ArenaObsV2 const& o)
+    {
+        std::vector<float> const base = FeaturesV2(o);
+        std::vector<float> f;
+        f.reserve(199);
+        for (int i = 0; i < 6; ++i)
+        {
+            f.insert(f.end(), base.begin() + i * 25, base.begin() + (i + 1) * 25);
+            UnitObs const& s = o.slot[i];
+            for (int dr : {s.drStun, s.drFear, s.drIncap, s.drSilence})
+                f.push_back(std::min(dr, 3) / 3.0f);
+            f.push_back(std::min(s.ccLeft, 8000) / 8000.0f);
+            f.push_back(float(s.kickReady));
+            f.push_back(float(s.ccReady));
+            f.push_back(float(s.defReady));
+        }
+        f.push_back(float(o.killWindow));
+        return f;
+    }
+
+    // The observation a loaded net was trained on, by its input size (151 = v2/v3 nets, 199 = v4)
+    inline std::vector<float> FeaturesFor(int inputSize, ArenaObsV2 const& o)
+    {
+        return inputSize == 199 ? FeaturesV4(o) : FeaturesV2(o);
+    }
