+    // Max-rank spell ids by role (a unit counts as "ready" when it knows one of them and it is off cooldown)
+    inline bool AnyReady(Player* p, std::initializer_list<uint32> spells)
+    {
+        for (uint32 id : spells)
+            if (p->HasSpell(id) && !p->HasSpellCooldown(id))
+                return true;
+        return false;
+    }
+
+    inline void ObserveCooldowns(Player* u, UnitObs& s)
+    {
+        s.drStun = int(u->GetDiminishing(DIMINISHING_STUN));
+        s.drFear = int(u->GetDiminishing(DIMINISHING_FEAR));
+        s.drIncap = int(u->GetDiminishing(DIMINISHING_DISORIENT));
+        s.drSilence = int(u->GetDiminishing(DIMINISHING_SILENCE));
+        int left = 0;
+        for (AuraType type : {SPELL_AURA_MOD_STUN, SPELL_AURA_MOD_FEAR, SPELL_AURA_MOD_CONFUSE,
+                              SPELL_AURA_MOD_SILENCE, SPELL_AURA_MOD_ROOT})
+            for (AuraEffect const* eff : u->GetAuraEffectsByType(type))
+                left = std::max(left, eff->GetBase()->GetDuration());
+        s.ccLeft = left;
+        // Kick, Counterspell, Wind Shear, Pummel, Shield Bash, Mind Freeze, Strangulate, Silence, Silencing Shot
+        s.kickReady = AnyReady(u, {1766, 2139, 57994, 6552, 72, 47528, 47476, 15487, 34490}) ? 1 : 0;
+        // Blind, Kidney Shot, Gouge, Polymorph, Deep Freeze, Psychic Scream, Psychic Horror, Fear, Death Coil, Howl
+        // of Terror, Cyclone, Hex, Hammer of Justice, Repentance, Intimidating Shout, Hungering Cold, Scatter Shot,
+        // Freezing Trap
+        s.ccReady = AnyReady(u, {2094, 8643, 1776, 12826, 44572, 10890, 64044, 6215, 47860, 17928, 33786, 51514,
+                                 10308, 20066, 5246, 49203, 19503, 14311}) ? 1 : 0;
+        // Pain Suppression, Divine Shield, Ice Block, Cloak of Shadows, Barkskin, Hand of Protection, Anti-Magic
+        // Shell, Icebound Fortitude, Deterrence, Evasion, Dispersion, Shield Wall
+        s.defReady = AnyReady(u, {33206, 642, 45438, 31224, 22812, 10278, 48707, 48792, 19263, 26669, 47585,
+                                  871}) ? 1 : 0;
+    }
+
