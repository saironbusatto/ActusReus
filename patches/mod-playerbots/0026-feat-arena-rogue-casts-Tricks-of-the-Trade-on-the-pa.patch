     triggers.push_back(new TriggerNode("dance ambush", { NextAction("ambush", ACTION_HIGH + 7) }));
     triggers.push_back(new TriggerNode("shadow dance opener", { NextAction("shadow dance", ACTION_HIGH + 6) }));
+    triggers.push_back(new TriggerNode("tricks on partner", { NextAction("tricks on partner", ACTION_HIGH + 6) }));
 
     // Manual §2: Cheap Shot -> Kidney Shot combo
     triggers.push_back(
