diff --git a/src/Ai/Class/Rogue/RogueTriggers.cpp b/src/Ai/Class/Rogue/RogueTriggers.cpp
index 13209941..9a66f14c 100644
--- a/src/Ai/Class/Rogue/RogueTriggers.cpp
+++ b/src/Ai/Class/Rogue/RogueTriggers.cpp
@@ -273,3 +273,17 @@ bool ArenaPrepStealthTrigger::IsActive()
     return bg && (bg->GetStatus() == STATUS_WAIT_JOIN || bg->GetStatus() == STATUS_IN_PROGRESS) &&
            botAI->CanCastSpell("stealth", bot);
 }
+
+// Burst call: Tricks of the Trade on the partner (+15% damage for 6 s after the rogue's next hit)
+bool TricksOnPartnerTrigger::IsActive()
+{
+    if (!bot->InArena() || bot->HasSpellCooldown(57934) || botAI->HasAura("tricks of the trade", bot))
+        return false;
+
+    if (!botAI->HasAura("shadow dance", bot) && !ai::arena::KillWindowOpen(botAI))
+        return false;
+
+    Unit* partner = ai::arena::FindPartner(botAI);
+    return partner && bot->IsWithinDistInMap(partner, 20.0f) && bot->IsWithinLOSInMap(partner) &&
+           botAI->CanCastSpell("tricks of the trade", partner);
+}
diff --git a/src/Ai/Class/Rogue/RogueTriggers.h b/src/Ai/Class/Rogue/RogueTriggers.h
index 7646ad5f..a57506ae 100644
--- a/src/Ai/Class/Rogue/RogueTriggers.h
+++ b/src/Ai/Class/Rogue/RogueTriggers.h
@@ -200,6 +200,14 @@ public:
     bool IsActive() override;
 };
 
+class TricksOnPartnerTrigger : public Trigger
+{
+public:
+    TricksOnPartnerTrigger(PlayerbotAI* botAI) : Trigger(botAI, "tricks on partner") {}
+
+    bool IsActive() override;
+};
+
 class PremeditationTrigger : public Trigger
 {
 public:
