@@ -197,6 +199,7 @@ public:
         creators["premeditation"] = &RogueAiObjectContextInternal::premeditation;
         creators["sap on enemy healer"] = &RogueAiObjectContextInternal::sap_on_enemy_healer;
         creators["reach sap target"] = &RogueAiObjectContextInternal::reach_sap_target;
+        creators["tricks on partner"] = &RogueAiObjectContextInternal::tricks_on_partner;
         creators["blind on enemy healer"] = &RogueAiObjectContextInternal::blind_on_enemy_healer;
     }
 
@@ -271,6 +274,7 @@ private:
     static Action* premeditation(PlayerbotAI* botAI) { return new CastPremeditationAction(botAI); }
