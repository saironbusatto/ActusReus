From 48342893a78e3fbc0e5f0e9ffd5c3e25ba601e4a Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Mon, 2 Nov 2026 15:03:58 -0300
Subject: [PATCH] fix(arena): healer heals before buffs and totems, fast heal
 first, trinket for the most hurt ally

A resto shaman spent two GCDs on Call of the Elements and Water Shield with
its partner at 12%, then cast the 2.5 s Healing Wave. Buff and damage totems,
Call of the Elements, Water Shield, Inner Fire and Lifeblood now wait while an
ally is below LowHealth (tremor, mana tide, stoneclaw, healing stream, earthbind,
grounding and cleansing stay free). Critical health: Lesser Healing Wave before
Healing Wave. A CC'd healer trinkets when the most hurt ally is below 50%.

Claude-Session: https://claude.ai/code/session_01H3noneHhUz8RFkv88ToEQ9
---
 src/Ai/Base/Strategy/BattlegroundStrategy.cpp | 21 ++++++++++++++++++-
 src/Ai/Base/Trigger/PvpTriggers.cpp           |  8 +++++++
 .../Shaman/Strategy/RestoShamanStrategy.cpp   |  5 +++--
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
index 049725dd..d7ab82df 100644
--- a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
+++ b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
@@ -9,6 +9,20 @@
 #include "GenericSpellActions.h"
 #include "Playerbots.h"
 
+// Buff and damage totems wait for the heal; tremor, mana tide, stoneclaw, healing stream, earthbind, grounding and
+// cleansing save the ally or the healer, and the "set"/"no" totem config actions are not casts
+static bool IsBuffTotem(std::string const& name)
+{
+    static char const* const keep[] = {"tremor", "mana tide", "stoneclaw", "healing stream", "earthbind", "grounding",
+                                       "cleansing"};
+    if (name.find(" totem") == std::string::npos || name.rfind("set ", 0) == 0 || name.rfind("no ", 0) == 0)
+        return false;
+    for (char const* k : keep)
+        if (name.find(k) != std::string::npos)
+            return false;
+    return true;
+}
+
 float ArenaHealerEmergencyMultiplier::GetValue(Action* action)
 {
     constexpr uint8 MIN_MANA_PCT = 15;
@@ -17,9 +31,14 @@ float ArenaHealerEmergencyMultiplier::GetValue(Action* action)
         return 1.0f;
 
     std::string const name = action->getName();
+    // Self-buffs and totems too: a resto shaman spent two GCDs on Call of the Elements and Water Shield
+    // with its partner at 12%
     bool const yieldsToHeal = name == "dps assist" || name == "set facing" || name == "drop target" ||
                               name == "attack enemy player" || name == "purge" || name == "wind shear" ||
-                              name == "wind shear on enemy healer" || dynamic_cast<CurePartyMemberAction*>(action) || dynamic_cast<CastCureSpellAction*>(action);
+                              name == "wind shear on enemy healer" || name == "call of the elements" ||
+                              name == "water shield" || name == "inner fire" || name == "lifeblood" ||
+                              IsBuffTotem(name) ||
+                              dynamic_cast<CurePartyMemberAction*>(action) || dynamic_cast<CastCureSpellAction*>(action);
     if (!yieldsToHeal || !PlayerbotAI::IsHeal(bot) || bot->GetPowerPct(POWER_MANA) < MIN_MANA_PCT)
         return 1.0f;
 
diff --git a/src/Ai/Base/Trigger/PvpTriggers.cpp b/src/Ai/Base/Trigger/PvpTriggers.cpp
index cc189d6b..aeaf1e40 100644
--- a/src/Ai/Base/Trigger/PvpTriggers.cpp
+++ b/src/Ai/Base/Trigger/PvpTriggers.cpp
@@ -351,6 +351,14 @@ bool PvpTrinketTrigger::IsActive()
     if (!lostControl)
         return false;
 
+    // A healer locked out while the most hurt ally drops: in 3v3 FindPartner may be the healthy one
+    if (PlayerbotAI::IsHeal(bot))
+    {
+        Unit* ally = AI_VALUE(Unit*, "party member to heal");
+        if (ally && ally->GetHealthPct() < 50.0f)
+            return true;
+    }
+
     // Partner about to die while we are locked, or we are the one being burst down under CC
     Unit* partner = ai::arena::FindPartner(botAI);
     if (partner && partner->GetHealthPct() < 35.0f)
diff --git a/src/Ai/Class/Shaman/Strategy/RestoShamanStrategy.cpp b/src/Ai/Class/Shaman/Strategy/RestoShamanStrategy.cpp
index b0cf7349..c0233a73 100644
--- a/src/Ai/Class/Shaman/Strategy/RestoShamanStrategy.cpp
+++ b/src/Ai/Class/Shaman/Strategy/RestoShamanStrategy.cpp
@@ -26,9 +26,10 @@ void RestoShamanStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
     triggers.push_back(new TriggerNode("group heal setting", { NextAction("riptide on party", 27.0f),
                                                                NextAction("chain heal on party", 26.0f) }));
 
+    // Critical: the fast heal before the 2.5 s one, the ally may not live through a Healing Wave
     triggers.push_back(new TriggerNode("party member critical health", { NextAction("riptide on party", 25.0f),
-                                                                         NextAction("healing wave on party", 24.0f),
-                                                                         NextAction("lesser healing wave on party", 23.0f) }));
+                                                                         NextAction("lesser healing wave on party", 24.0f),
+                                                                         NextAction("healing wave on party", 23.0f) }));
 
     triggers.push_back(new TriggerNode("party member low health", { NextAction("riptide on party", 19.0f),
                                                                     NextAction("healing wave on party", 18.0f),
-- 
