From 8633d17489490713226e87e18903005f71918519 Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Sun, 1 Nov 2026 01:49:16 -0300
Subject: [PATCH 58/58] fix: use bot->Whisper to notify human player in
 GiveItemAction

---
 src/Ai/Base/Actions/GiveItemAction.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Ai/Base/Actions/GiveItemAction.cpp b/src/Ai/Base/Actions/GiveItemAction.cpp
index 5a88754b..3c36c5cf 100644
--- a/src/Ai/Base/Actions/GiveItemAction.cpp
+++ b/src/Ai/Base/Actions/GiveItemAction.cpp
@@ -87,7 +87,7 @@ bool GiveItemAction::Execute(Event /*event*/)
             if (receiverAi)
                 receiverAi->TellMasterNoFacing(out.str());
             else
-                botAI->TellPlayer(receiver, out.str());
+                bot->Whisper(out.str(), LANG_UNIVERSAL, receiver);
         }
         else
         {
@@ -97,7 +97,7 @@ bool GiveItemAction::Execute(Event /*event*/)
             if (receiverAi)
                 receiverAi->TellError(out.str());
             else
-                botAI->TellPlayer(receiver, out.str());
+                bot->Whisper(out.str(), LANG_UNIVERSAL, receiver);
         }
     }
 
