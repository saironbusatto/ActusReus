     return true;
 }
 
+// Ring of Valor lifts the teams on elevators that bots never really ride: some are carried with the wrong offset and
+// end ~7 yd above the floor, others stay on the bottom. The core only re-grounds a player that is not falling, and a
+// bot without a client can keep the falling flag, so it hung there casting out of melee reach.
+bool ArenaTactics::FloatingInRingOfValor(Player* bot, float* groundZ)
+{
+    // floor is 28.28; a running spline is a knockback arc or a real move, not a hang
+    if (bot->GetMapId() != 618 || bot->GetPositionZ() < 30.5f || !bot->movespline->Finalized())
+        return false;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetStatus() != STATUS_IN_PROGRESS)
+        return false;
+
+    uint32 const prep = sWorld->getIntConfig(CONFIG_ARENA_PREP_TIME) * IN_MILLISECONDS;
+    if (bg->GetStartTime() < prep + 21000)  // still riding
+        return false;
+
+    float const x = bot->GetPositionX();
+    float const y = bot->GetPositionY();
+    float const z = bot->GetPositionZ() + 0.5f;
+    float const ground = std::max(bot->GetMap()->GetHeight(x, y, z, true, 50.0f),
+                                  bot->GetMap()->GetDynamicMapTree().getHeight(x, y, z, 50.0f, bot->GetPhaseMask()));
+    if (ground < 28.0f || bot->GetPositionZ() <= ground + 3.5f)  // same slack as BattlegroundRV::CheckPositionForUnit
+        return false;
+
+    if (groundZ)
+        *groundZ = ground;
+    return true;
+}
+
+bool ArenaTactics::dropToRingFloor(Battleground* bg)
+{
+    float ground;
+    if (!FloatingInRingOfValor(bot, &ground))
+        return false;
+
+    bot->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_TELEPORTED | AURA_INTERRUPT_FLAG_CHANGE_MAP);
+    bot->TeleportTo(bg->GetMapId(), bot->GetPositionX(), bot->GetPositionY(), ground + 0.5f, bot->GetOrientation());
+    return true;
+}
+
 bool ArenaTactics::Execute(Event /*event*/)
 {
     if (!bot->InBattleground())
@@ -4272,7 +4314,7 @@ bool ArenaTactics::Execute(Event /*event*/)
     if (bot->isDead())
         return false;
 
-    if (leaveDalaranPipe(bg))
+    if (leaveDalaranPipe(bg) || dropToRingFloor(bg))
         return true;
 
     if (bot->isMoving())
