         creators["hyperspeed accelerators"] = &TriggerContext::hyperspeed_accelerators;
         creators["cobalt frag bomb"] = &TriggerContext::cobalt_frag_bomb;
         creators["partner bursting"] = &TriggerContext::partner_bursting;
+        creators["arena peel"] = &TriggerContext::arena_peel;
         creators["enemy too close for shoot"] = &TriggerContext::enemy_too_close_for_shoot;
         creators["enemy too close for auto shot"] = &TriggerContext::enemy_too_close_for_auto_shot;
         creators["enemy too close for melee"] = &TriggerContext::enemy_too_close_for_melee;
@@ -366,6 +367,7 @@ private:
     static Trigger* hyperspeed_accelerators(PlayerbotAI* botAI) { return new HyperspeedTrigger(botAI); }
     static Trigger* cobalt_frag_bomb(PlayerbotAI* botAI) { return new FragBombTrigger(botAI); }
     static Trigger* partner_bursting(PlayerbotAI* botAI) { return new PartnerBurstingTrigger(botAI); }
+    static Trigger* arena_peel(PlayerbotAI* botAI) { return new ArenaPeelTrigger(botAI); }
     static Trigger* enemy_too_close_for_auto_shot(PlayerbotAI* botAI)
     {
         return new EnemyTooCloseForAutoShotTrigger(botAI);
