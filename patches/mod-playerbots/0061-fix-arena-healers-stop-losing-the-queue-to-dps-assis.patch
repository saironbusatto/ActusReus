From d081e32cba895aee48ce565125cbe3535a22e31d Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Mon, 2 Nov 2026 01:07:02 -0300
Subject: [PATCH] fix: arena healers stop losing the queue to dps assist while
 an ally dies

Claude-Session: https://claude.ai/code/session_01H3noneHhUz8RFkv88ToEQ9
---
 src/Ai/Base/Strategy/BattlegroundStrategy.cpp | 29 +++++++++++++++++++
 src/Ai/Base/Strategy/BattlegroundStrategy.h   | 11 +++++++
 2 files changed, 40 insertions(+)

diff --git a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
index a6e4c919..013e45fd 100644
--- a/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
+++ b/src/Ai/Base/Strategy/BattlegroundStrategy.cpp
@@ -5,8 +5,32 @@
  */
 
 #include "BattlegroundStrategy.h"
+
+#include "GenericSpellActions.h"
 #include "Playerbots.h"
 
+float ArenaHealerEmergencyMultiplier::GetValue(Action* action)
+{
+    constexpr uint8 MIN_MANA_PCT = 15;
+
+    if (!bot->InArena())
+        return 1.0f;
+
+    std::string const name = action->getName();
+    bool const yieldsToHeal = name == "dps assist" || name == "set facing" || name == "drop target" ||
+                              name == "attack enemy player" || name == "purge" ||
+                              dynamic_cast<CurePartyMemberAction*>(action) || dynamic_cast<CastCureSpellAction*>(action);
+    if (!yieldsToHeal || !PlayerbotAI::IsHeal(bot) || bot->GetPowerPct(POWER_MANA) < MIN_MANA_PCT)
+        return 1.0f;
+
+    Unit* ally = AI_VALUE(Unit*, "party member to heal");
+    if (!ally || ally->GetHealthPct() >= sPlayerbotAIConfig.LowHealth ||
+        bot->GetDistance(ally) > sPlayerbotAIConfig.HealDistance || !bot->IsWithinLOSInMap(ally))
+        return 1.0f;
+
+    return 0.0f;
+}
+
 void BGStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
 {
     triggers.push_back(new TriggerNode("often", { NextAction("bg join", relevance)}));
@@ -82,6 +106,11 @@ void IsleStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
     triggers.push_back(new TriggerNode("in vehicle", { NextAction("glaive throw", ACTION_MOVE + 9.0f)}));
 }
 
+void ArenaStrategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
+{
+    multipliers.push_back(new ArenaHealerEmergencyMultiplier(botAI));
+}
+
 void ArenaStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
 {
     triggers.push_back(
diff --git a/src/Ai/Base/Strategy/BattlegroundStrategy.h b/src/Ai/Base/Strategy/BattlegroundStrategy.h
index 96867264..cc4c8702 100644
--- a/src/Ai/Base/Strategy/BattlegroundStrategy.h
+++ b/src/Ai/Base/Strategy/BattlegroundStrategy.h
@@ -79,6 +79,16 @@ public:
     std::string const getName() override { return "isle"; }
 };
 
+// The action queue is ordered by raw relevance and heals sit at 15-36, below "dps assist" (50) and dispels: while an
+// ally could be healed and is about to die, those actions must be skipped, since a multiplier above 1 reorders nothing.
+class ArenaHealerEmergencyMultiplier : public Multiplier
+{
+public:
+    ArenaHealerEmergencyMultiplier(PlayerbotAI* botAI) : Multiplier(botAI, "arena healer emergency") {}
+
+    float GetValue(Action* action) override;
+};
+
 class ArenaStrategy : public Strategy
 {
 public:
@@ -86,6 +96,7 @@ public:
 
     uint32 GetType() const override { return STRATEGY_TYPE_GENERIC; }
     void InitTriggers(std::vector<TriggerNode*>& triggers) override;
+    void InitMultipliers(std::vector<Multiplier*>& multipliers) override;
     std::string const getName() override { return "arena"; }
 };
 
