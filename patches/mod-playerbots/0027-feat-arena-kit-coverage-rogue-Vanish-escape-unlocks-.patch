+// Arena: keep a Lifebloom rolling on the partner (the generic one only targets a dungeon main tank)
+bool LifebloomOnPartnerTrigger::IsActive()
+{
+    if (!bot->InArena())
+        return false;
+
+    Unit* partner = ai::arena::FindPartner(botAI);
+    return partner && partner->IsInCombat() && bot->IsWithinDistInMap(partner, 40.0f) &&
+           !botAI->HasAura("lifebloom", partner, false, true) && botAI->CanCastSpell("lifebloom", partner);
+}
+
+namespace
+{
+    Unit* VisibleEnemyRogue(PlayerbotAI* botAI)
+    {
+        for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("possible targets")->Get())
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (u && u->IsAlive() && u->IsPlayer() && u->ToPlayer()->getClass() == CLASS_ROGUE)
+                return u;
+        }
+        return nullptr;
+    }
+}
+
+// Arena: Faerie Fire on the enemy rogue so it cannot restealth or Vanish back into an opener
+bool FaerieFireOnEnemyRogueTrigger::IsActive()
+{
+    if (!bot->InArena())
+        return false;
+
+    Unit* rogue = VisibleEnemyRogue(botAI);
+    return rogue && bot->IsWithinDistInMap(rogue, 30.0f) && bot->IsWithinLOSInMap(rogue) &&
+           !botAI->HasAura("faerie fire", rogue);
+}
+
+// Night Elf: Shadowmeld drops the bot as a target and cancels the Fear/Cyclone/Polymorph being cast at it
+bool ShadowmeldVsCastTrigger::IsActive()
+{
+    if (!bot->InArena() || bot->HasSpellCooldown(58984) || bot->isMoving())
+        return false;
+
+    for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get())
+    {
+        Unit* u = botAI->GetUnit(guid);
+        Spell* spell = u ? u->GetCurrentSpell(CURRENT_GENERIC_SPELL) : nullptr;
+        if (spell && spell->m_targets.GetUnitTarget() == bot && spell->GetSpellInfo()->HasAura(SPELL_AURA_MOD_FEAR))
+            return botAI->CanCastSpell(58984, bot);
+        if (spell && spell->m_targets.GetUnitTarget() == bot && spell->GetSpellInfo()->Id == 33786)  // Cyclone
+            return botAI->CanCastSpell(58984, bot);
+    }
+    return false;
+}
