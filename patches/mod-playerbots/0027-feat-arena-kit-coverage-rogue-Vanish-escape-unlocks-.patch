+class CastLifebloomOnPartnerAction : public CastSpellAction
+{
+public:
+    CastLifebloomOnPartnerAction(PlayerbotAI* botAI) : CastSpellAction(botAI, "lifebloom") {}
+    Unit* GetTarget() override { return ai::arena::FindPartner(botAI); }
+};
+
+class CastFaerieFireOnEnemyRogueAction : public CastSpellAction
+{
+public:
+    CastFaerieFireOnEnemyRogueAction(PlayerbotAI* botAI) : CastSpellAction(botAI, "faerie fire") {}
+    Unit* GetTarget() override
+    {
+        for (ObjectGuid const guid : AI_VALUE(GuidVector, "possible targets"))
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (u && u->IsAlive() && u->IsPlayer() && u->ToPlayer()->getClass() == CLASS_ROGUE)
+                return u;
+        }
+        return nullptr;
+    }
+};
+
+class CastShadowmeldAction : public Action
+{
+public:
+    CastShadowmeldAction(PlayerbotAI* botAI) : Action(botAI, "shadowmeld") {}
+    bool Execute(Event /*event*/) override { return botAI->CastSpell(58984, bot); }
+};
