+// Arena opener: the healer is out of Sap range, so walk to it in stealth while it is still out of combat
+bool SapTargetFarTrigger::IsActive()
+{
+    if (!bot->InArena() || !botAI->HasAura("stealth", bot) || bot->isMoving())
+        return false;
+
+    Unit* healer = ai::arena::FindVisibleEnemyHealer(botAI);
+    return healer && !healer->IsInCombat() && !bot->IsWithinDistInMap(healer, 9.0f) &&
+           bot->IsWithinDistInMap(healer, 60.0f) &&
+           healer->GetDiminishing(DIMINISHING_DISORIENT) < DIMINISHING_LEVEL_IMMUNE;
+}
