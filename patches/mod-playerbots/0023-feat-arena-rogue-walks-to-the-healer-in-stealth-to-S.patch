+// Burst coordination: when the partner commits (Shadow Dance or Hyperspeed up), lock the other enemy now
+namespace ai::arena
+{
+    inline bool PartnerBursting(PlayerbotAI* botAI)
+    {
+        Unit* partner = FindPartner(botAI);
+        return partner && (partner->HasAura(51713) /*Shadow Dance*/ || partner->HasAura(SPELL_HYPERSPEED_ACCELERATION));
+    }
+
+    inline bool IsLockedDown(Unit* u)
+    {
+        return u->HasUnitState(UNIT_STATE_STUNNED) || u->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+               u->HasAuraType(SPELL_AURA_MOD_CONFUSE) || u->HasAura(33786) /*Cyclone*/;
+    }
+}
+
+class PartnerBurstingTrigger : public Trigger
+{
+public:
+    PartnerBurstingTrigger(PlayerbotAI* botAI) : Trigger(botAI, "partner bursting") {}
+
+    bool IsActive() override
+    {
+        if (!sPlayerbotAIConfig.ArenaPvpStrategies || !bot->InArena() || !ai::arena::PartnerBursting(botAI))
+            return false;
+
+        Unit* cc = ai::arena::CcTarget(botAI);
+        return cc && !ai::arena::IsLockedDown(cc);
+    }
+};
+
+class CcOnCcTargetAction : public Action
+{
+public:
+    CcOnCcTargetAction(PlayerbotAI* botAI) : Action(botAI, "cc on cc target") {}
+
+    bool Execute(Event /*event*/) override
+    {
+        Unit* cc = ai::arena::CcTarget(botAI);
+        if (!cc)
+            return false;
+
+        // CC spells in preference order; the first one this bot can cast on the target wins
+        for (char const* spell : {"cyclone", "fear", "death coil", "psychic scream", "blind", "gouge", "silence"})
+            if (botAI->CanCastSpell(spell, cc))
+                return botAI->CastSpell(spell, cc);
+        return false;
+    }
+};
+
