+// Learned arena policy v2 (ml/policy/train_v2.py, DeepSets): the same encoder per unit slot (self, 2 allies,
+// 3 enemies); self + mean of present allies + mean of present enemies + kill window -> trunk -> action logits.
+// Standard library only, so ml/policy/paridade_v2.cpp can check it against torch outside the server.
+namespace ai::arena
+{
+    struct PolicyNetV2
+    {
+        int perSlot = 0, slots = 0, emb = 0, hidden = 0, nOut = 0;
+        std::unordered_map<std::string, int> index;
+        std::vector<float> encW, encB, trunkW, trunkB, piW, piB;
+        bool ok = false;
+
+        static bool ReadFloats(std::ifstream& in, std::vector<float>& out, size_t n)
+        {
+            out.resize(n);
+            for (float& v : out)
+                if (!(in >> v))
+                    return false;
+            return true;
+        }
+
+        // "arena-policy v2 <per_slot> <slots> <emb> <hidden> <n_out>", action names joined by '|',
+        // then enc, trunk, pi: weight rows (out x in), bias
+        explicit PolicyNetV2(std::string const& path)
+        {
+            std::ifstream in(path);
+            std::string magic, version, names;
+            if (!(in >> magic >> version >> perSlot >> slots >> emb >> hidden >> nOut) || magic != "arena-policy" ||
+                version != "v2" || slots != 6 || perSlot <= 0 || emb <= 0 || hidden <= 0 || nOut <= 0)
+                return;
+            in >> std::ws;
+            std::getline(in, names);
+            std::stringstream ss(names);
+            std::string name;
+            for (int i = 0; std::getline(ss, name, '|'); ++i)
+                index[name] = i;
+
+            ok = int(index.size()) == nOut && ReadFloats(in, encW, size_t(emb) * perSlot) && ReadFloats(in, encB, emb) &&
+                 ReadFloats(in, trunkW, size_t(hidden) * (3 * emb + 1)) && ReadFloats(in, trunkB, hidden) &&
+                 ReadFloats(in, piW, size_t(nOut) * hidden) && ReadFloats(in, piB, nOut);
+        }
+
+        size_t InputSize() const { return size_t(slots) * perSlot + 1; }
+
+        static void Dense(float const* x, size_t nIn, std::vector<float> const& w, std::vector<float> const& b,
+                          bool relu, float* y)
+        {
+            for (size_t o = 0; o < b.size(); ++o)
+            {
+                float v = b[o];
+                for (size_t i = 0; i < nIn; ++i)
+                    v += w[o * nIn + i] * x[i];
+                y[o] = relu && v < 0 ? 0 : v;
+            }
+        }
+
+        // Softmax over the action vocabulary; x = FeaturesV2 (slot fields, then kill window), size InputSize().
+        // Slot field 0 is "present": absent slots stay out of the means, as in PolicyV2.forward.
+        std::vector<float> Probabilities(std::vector<float> const& x) const
+        {
+            std::vector<float> e(emb), pooled(3 * emb + 1, 0.0f), h(hidden), logits(nOut);
+            float count[3] = {0, 0, 0};
+            for (int s = 0; s < slots; ++s)
+            {
+                float const* slot = &x[size_t(s) * perSlot];
+                if (slot[0] <= 0)
+                    continue;
+                int const group = s == 0 ? 0 : (s < 3 ? 1 : 2);
+                Dense(slot, perSlot, encW, encB, true, e.data());
+                for (int k = 0; k < emb; ++k)
+                    pooled[group * emb + k] += e[k];
+                ++count[group];
+            }
+            for (int g = 0; g < 3; ++g)
+                for (int k = 0; k < emb; ++k)
+                    pooled[g * emb + k] /= std::max(count[g], 1.0f);
+            pooled[3 * emb] = x.back();
+
+            Dense(pooled.data(), pooled.size(), trunkW, trunkB, true, h.data());
+            Dense(h.data(), h.size(), piW, piB, false, logits.data());
+            float const top = *std::max_element(logits.begin(), logits.end());
+            float sum = 0;
+            for (float& v : logits)
+                sum += (v = std::exp(v - top));
+            for (float& v : logits)
+                v /= sum;
+            return logits;
+        }
+    };
+}
+
+#endif
