+    // The policy to use for this bot right now, or nullptr when the rules decide alone
+    inline PolicyNetV2 const* ActivePolicy(Player* bot)
+    {
+        if (MlTeams().empty() || !bot->InArena())
+            return nullptr;
+        for (uint8 slot = 0; slot < 3; ++slot)  // 2v2, 3v3, 5v5 team slots
+            if (MlTeams().count(bot->GetArenaTeamId(slot)))
+                return Policy().ok ? &Policy() : nullptr;
+        return nullptr;
+    }
+
+    // Engine hook for each executed arena action: logs it with the probability the policy gave it
+    // (1 when only the rules decided, as LogObservation expects)
+    inline void LogDecision(PlayerbotAI* botAI, Action* action, float relevance)
+    {
+        ArenaObsV2 const o = CollectObservationV2(botAI);
+        float prob = 1.0f;
+        if (PolicyNetV2 const* net = ActivePolicy(botAI->GetBot()))
+        {
+            auto const it = net->index.find(action->getName());
+            if (it != net->index.end())
+                prob = net->Probabilities(FeaturesV2(o))[it->second];
+        }
+        LogObservation(botAI, o, action, relevance, prob);
+    }
