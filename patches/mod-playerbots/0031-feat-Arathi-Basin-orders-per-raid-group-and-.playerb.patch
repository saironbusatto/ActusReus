+#ifndef PLAYERBOTS_ABORDERACTION_H
+#define PLAYERBOTS_ABORDERACTION_H
+
+#include "Action.h"
+
+class PlayerbotAI;
+
+// Arathi Basin order from the raid: "ab <t1..t8|all> <stables|blacksmith|farm|lumber|mine|free>" (Portuguese node
+// names too). t<N> is raid subgroup N. The ordered bots keep that node as their objective until told "free".
+class AbOrderAction : public Action
+{
+public:
+    AbOrderAction(PlayerbotAI* botAI) : Action(botAI, "ab") {}
+
+    bool Execute(Event event) override;
+
+    // Node index (BG_AB_NODE_*) for a spoken/typed name, -1 for "free", -2 if unknown
+    static int ParseNode(std::string const& word);
+    // Raid subgroup (0..7) for "t<N>"/"g<N>", -1 for everyone, -2 if unknown
+    static int ParseTarget(std::string const& word);
+};
+
+#endif
