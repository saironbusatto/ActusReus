+    // ".playerbots raid <player> <text>": say <text> in <player>'s raid chat on their behalf, so the bots take it as
+    // that player's command (used by the voice bridge, which has no game client of its own)
+    static bool HandleRaidCommand(ChatHandler* handler, char const* args)
+    {
+        std::string const line = args ? args : "";
+        size_t const space = line.find(' ');
+        Player* player = space == std::string::npos ? nullptr : ObjectAccessor::FindPlayerByName(line.substr(0, space));
+        Group* group = player ? player->GetGroup() : nullptr;
+        if (!group)
+        {
+            handler->PSendSysMessage("usage: .playerbots raid <online player in a group> <text>");
+            return false;
+        }
+
+        std::string const text = line.substr(space + 1);
+        WorldPacket data;
+        ChatHandler::BuildChatPacket(data, group->isRaidGroup() ? CHAT_MSG_RAID : CHAT_MSG_PARTY, LANG_UNIVERSAL,
+                                     player, nullptr, text);
+        group->BroadcastPacket(&data, false);
+
+        uint32 bots = 0;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(ref->GetSource()))
+            {
+                botAI->HandleCommand(CHAT_MSG_RAID, text, player);
+                ++bots;
+            }
+
+        handler->PSendSysMessage("raid: '{}' sent to {} bots", text, bots);
+        return true;
+    }
