+
+int AbOrderAction::ParseNode(std::string const& word)
+{
+    static std::unordered_map<std::string, int> const nodes = {
+        {"stables", 0},    {"estabulo", 0},  {"estábulo", 0}, {"st", 0},
+        {"blacksmith", 1}, {"ferreiro", 1},  {"bs", 1},
+        {"farm", 2},       {"fazenda", 2},
+        {"lumber", 3},     {"serraria", 3},  {"madeireira", 3}, {"lm", 3},
+        {"mine", 4},       {"mina", 4},      {"gm", 4},
+        {"free", -1},      {"livre", -1},    {"solto", -1},
+    };
+    auto const it = nodes.find(word);
+    return it == nodes.end() ? -2 : it->second;
+}
+
+int AbOrderAction::ParseTarget(std::string const& word)
+{
+    if (word == "all" || word == "todos")
+        return -1;
+    if (word.size() == 2 && (word[0] == 't' || word[0] == 'g') && word[1] >= '1' && word[1] <= '8')
+        return word[1] - '1';
+    return -2;
+}
+
+bool AbOrderAction::Execute(Event event)
+{
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetBgTypeID() != BATTLEGROUND_AB)
+        return false;
+
+    std::istringstream in(event.getParam());
+    std::string who, where;
+    in >> who >> where;
+    std::transform(who.begin(), who.end(), who.begin(), ::tolower);
+    std::transform(where.begin(), where.end(), where.begin(), ::tolower);
+
+    int const target = ParseTarget(who);
+    int const node = ParseNode(where);
+    if (target == -2 || node == -2)
+        return false;
+
+    Group* group = bot->GetGroup();
+    if (target >= 0 && (!group || group->GetMemberGroup(bot->GetGUID()) != target))
+        return false;
+
+    // Instance id in the high bits, so an order never leaks into the next battleground
+    context->GetValue<uint32>("ab order")->Set(node < 0 ? 0 : (bg->GetInstanceID() << 3) | uint32(node + 1));
+    context->GetValue<PositionMap&>("position")->Get()["bg objective"].Reset();
+    return true;
+}
