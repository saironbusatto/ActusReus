 #include "WarlockTriggers.h"
 #include "ArenaHelpers.h"
+#include "Battleground.h"
 #include "GenericTriggers.h"
 #include "Player.h"
 #include "PlayerbotAI.h"
@@ -313,3 +314,31 @@ bool CurseOfTonguesOnCasterTrigger::IsActive()
 
     return botAI->CanCastSpell("curse of tongues", caster);
 }
+
+// Arena: drop the circle once the gates are open, while nobody is on top of the warlock yet
+bool DemonicCircleSummonTrigger::IsActive()
+{
+    if (!bot->InArena() || botAI->HasAura("demonic circle: summon", bot))
+        return false;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetStatus() != STATUS_IN_PROGRESS || bg->GetStartDelayTime() > 0)
+        return false;
+
+    return !ai::arena::CountEnemiesNear(botAI, 15.0f) && botAI->CanCastSpell("demonic circle: summon", bot);
+}
+
+// Arena: burn the teleport to escape a melee burst (just out of the stun) or a root/snare
+bool DemonicCircleTeleportTrigger::IsActive()
+{
+    if (!bot->InArena() || !botAI->HasAura("demonic circle: summon", bot))
+        return false;
+
+    bool const meleeOnMe = ai::arena::CountEnemiesNear(botAI, 6.0f) > 0;
+    bool const underBurst = meleeOnMe && bot->GetHealthPct() < 60.0f;
+    bool const pinned = meleeOnMe && (bot->HasAuraType(SPELL_AURA_MOD_ROOT) || bot->HasAuraType(SPELL_AURA_MOD_DECREASE_SPEED));
+    if (!underBurst && !pinned)
+        return false;
+
+    return botAI->CanCastSpell("demonic circle: teleport", bot);
+}
