+++ b/src/Ai/Base/Actions/PassLeadershipToMasterAction.h
@@ -38,4 +38,14 @@ public:
     bool isUseful() override;
 };
 
+// Battleground raid led by a bot: hand the lead to a real player (GM or guildmate) so they can organize the raid
+class BgGiveLeaderAction : public Action
+{
+public:
+    BgGiveLeaderAction(PlayerbotAI* botAI) : Action(botAI, "bg give leader") {}
+
+    bool Execute(Event event) override;
+    bool isUseful() override;
+};
+
 #endif
