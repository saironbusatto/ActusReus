diff --git a/src/Ai/Base/ArenaEngineering.h b/src/Ai/Base/ArenaEngineering.h
new file mode 100644
index 00000000..804d0e1b
--- /dev/null
+++ b/src/Ai/Base/ArenaEngineering.h
@@ -0,0 +1,123 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#ifndef PLAYERBOTS_ARENAENGINEERING_H
+#define PLAYERBOTS_ARENAENGINEERING_H
+
+#include "Action.h"
+#include "ArenaHelpers.h"
+#include "Trigger.h"
+
+// Engineering in arena (2009 PvP standard): Hyperspeed Accelerators on the gloves for the burst window,
+// Cobalt Frag Bomb (3 s AoE stun, usable in arena) on the player who must sit in CC while the other dies.
+namespace ai::arena
+{
+    constexpr uint32 ENCHANT_HYPERSPEED_ACCELERATORS = 3604;
+    constexpr uint32 SPELL_HYPERSPEED_ACCELERATION = 54758;
+    constexpr uint32 ITEM_COBALT_FRAG_BOMB = 40771;
+    constexpr uint32 SPELL_COBALT_FRAG_BOMB = 67769;
+
+    inline Item* HyperspeedGloves(Player* bot)
+    {
+        Item* gloves = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_HANDS);
+        return gloves && gloves->GetEnchantmentId(PERM_ENCHANTMENT_SLOT) == ENCHANT_HYPERSPEED_ACCELERATORS ? gloves
+                                                                                                           : nullptr;
+    }
+
+    // The enemy who is not the kill target: the one the bomb should lock down
+    inline Unit* CcTarget(PlayerbotAI* botAI)
+    {
+        Unit* kill = botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+        for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get())
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (u && u != kill && u->IsAlive() && u->IsPlayer())
+                return u;
+        }
+        return nullptr;
+    }
+}
+
+class HyperspeedTrigger : public Trigger
+{
+public:
+    HyperspeedTrigger(PlayerbotAI* botAI) : Trigger(botAI, "hyperspeed accelerators") {}
+
+    bool IsActive() override
+    {
+        if (!sPlayerbotAIConfig.ArenaPvpStrategies || !bot->InArena() || !bot->IsInCombat() ||
+            !ai::arena::HyperspeedGloves(bot) || bot->HasSpellCooldown(ai::arena::SPELL_HYPERSPEED_ACCELERATION) ||
+            bot->HasAura(ai::arena::SPELL_HYPERSPEED_ACCELERATION))
+            return false;
+
+        if (PlayerbotAI::IsHeal(bot))  // healer: haste when the partner is going down
+        {
+            Unit* partner = ai::arena::FindPartner(botAI);
+            return partner && partner->GetHealthPct() < 50.0f;
+        }
+        return ai::arena::KillWindowOpen(botAI);  // DPS: haste goes with the burst
+    }
+};
+
+class UseHyperspeedAction : public Action
+{
+public:
+    UseHyperspeedAction(PlayerbotAI* botAI) : Action(botAI, "hyperspeed accelerators") {}
+
+    bool Execute(Event /*event*/) override
+    {
+        Item* gloves = ai::arena::HyperspeedGloves(bot);
+        if (!gloves)
+            return false;
+
+        SpellCastTargets targets;
+        targets.SetUnitTarget(bot);
+        bot->CastItemUseSpell(gloves, targets, 1, 0);
+        return true;
+    }
+};
+
+class FragBombTrigger : public Trigger
+{
+public:
+    FragBombTrigger(PlayerbotAI* botAI) : Trigger(botAI, "cobalt frag bomb") {}
+
+    bool IsActive() override
+    {
+        if (!sPlayerbotAIConfig.ArenaPvpStrategies || !bot->InArena() ||
+            !bot->HasItemCount(ai::arena::ITEM_COBALT_FRAG_BOMB, 1) ||
+            bot->HasSpellCooldown(ai::arena::SPELL_COBALT_FRAG_BOMB))
+            return false;
+
+        Unit* cc = ai::arena::CcTarget(botAI);
+        if (!cc || !bot->IsWithinDistInMap(cc, 28.0f) || !bot->IsWithinLOSInMap(cc) ||
+            cc->HasUnitState(UNIT_STATE_STUNNED) || cc->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+            cc->HasAuraType(SPELL_AURA_MOD_CONFUSE))
+            return false;
+
+        // Lock the CC target only when the burst is on, or when it is casting a heal
+        return ai::arena::KillWindowOpen(botAI) || (PlayerbotAI::IsHeal(cc->ToPlayer()) && cc->IsNonMeleeSpellCast(false));
+    }
+};
+
+class UseFragBombAction : public Action
+{
+public:
+    UseFragBombAction(PlayerbotAI* botAI) : Action(botAI, "cobalt frag bomb") {}
+
+    bool Execute(Event /*event*/) override
+    {
+        Unit* cc = ai::arena::CcTarget(botAI);
+        Item* bomb = bot->GetItemByEntry(ai::arena::ITEM_COBALT_FRAG_BOMB);
+        if (!cc || !bomb)
+            return false;
+
+        return bot->CastSpell(cc->GetPositionX(), cc->GetPositionY(), cc->GetPositionZ(),
+                              ai::arena::SPELL_COBALT_FRAG_BOMB, false, bomb) == SPELL_CAST_OK;
+    }
+};
+
+#endif
diff --git a/src/Ai/Base/ArenaMlPolicy.h b/src/Ai/Base/ArenaMlPolicy.h
new file mode 100644
index 00000000..f5002073
--- /dev/null
+++ b/src/Ai/Base/ArenaMlPolicy.h
@@ -0,0 +1,136 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#ifndef PLAYERBOTS_ARENAMLPOLICY_H
+#define PLAYERBOTS_ARENAMLPOLICY_H
+
+#include <fstream>
+#include <sstream>
+#include <unordered_map>
+
+#include "ArenaObservation.h"
+#include "Multiplier.h"
+#include "PlayerbotAIConfig.h"
+
+// Learned arena policy (ml/policy/train.py): a 48 -> 64 -> 64 -> N MLP evaluated in plain C++.
+// It never adds actions; it rescales the relevance of the actions the rule strategies already queued,
+// so the rules stay as the fallback. Only bots whose 2v2 team is in Playerbots.ArenaMlTeams use it.
+namespace ai::arena
+{
+    struct PolicyNet
+    {
+        int nIn = 0, nHidden = 0, nOut = 0;
+        std::unordered_map<std::string, int> index;
+        std::vector<float> w1, b1, w2, b2, w3, b3;
+        bool ok = false;
+
+        static bool ReadFloats(std::ifstream& in, std::vector<float>& out, size_t n)
+        {
+            out.resize(n);
+            for (float& v : out)
+                if (!(in >> v))
+                    return false;
+            return true;
+        }
+
+        explicit PolicyNet(std::string const& path)
+        {
+            std::ifstream in(path);
+            std::string magic, version, names;
+            if (!(in >> magic >> version >> nIn >> nHidden >> nOut) || magic != "arena-policy" || version != "v1" ||
+                nIn != 48)
+            {
+                LOG_ERROR("playerbots", "ArenaMlPolicy: cannot read '{}' (missing or wrong format)", path);
+                return;
+            }
+            in >> std::ws;
+            std::getline(in, names);
+            std::stringstream ss(names);
+            std::string name;
+            for (int i = 0; std::getline(ss, name, '|'); ++i)
+                index[name] = i;
+
+            ok = int(index.size()) == nOut && ReadFloats(in, w1, size_t(nHidden) * nIn) &&
+                 ReadFloats(in, b1, nHidden) && ReadFloats(in, w2, size_t(nHidden) * nHidden) &&
+                 ReadFloats(in, b2, nHidden) && ReadFloats(in, w3, size_t(nOut) * nHidden) &&
+                 ReadFloats(in, b3, nOut);
+            LOG_INFO("playerbots", "ArenaMlPolicy: '{}' {} ({} actions)", path, ok ? "loaded" : "INVALID", nOut);
+        }
+
+        static std::vector<float> Dense(std::vector<float> const& x, std::vector<float> const& w,
+                                        std::vector<float> const& b, bool relu)
+        {
+            std::vector<float> y(b);
+            size_t const nIn = x.size();
+            for (size_t o = 0; o < y.size(); ++o)
+            {
+                for (size_t i = 0; i < nIn; ++i)
+                    y[o] += w[o * nIn + i] * x[i];
+                if (relu && y[o] < 0)
+                    y[o] = 0;
+            }
+            return y;
+        }
+
+        // Softmax probabilities over the action vocabulary
+        std::vector<float> Probabilities(std::vector<float> const& x) const
+        {
+            std::vector<float> logits = Dense(Dense(Dense(x, w1, b1, true), w2, b2, true), w3, b3, false);
+            float const top = *std::max_element(logits.begin(), logits.end());
+            float sum = 0;
+            for (float& v : logits)
+                sum += (v = std::exp(v - top));
+            for (float& v : logits)
+                v /= sum;
+            return logits;
+        }
+    };
+
+    inline PolicyNet const& Policy()
+    {
+        static PolicyNet const net(sPlayerbotAIConfig.ArenaMlPolicyFile);  // loaded once, first use
+        return net;
+    }
+
+    class ArenaMlMultiplier : public Multiplier
+    {
+    public:
+        ArenaMlMultiplier(PlayerbotAI* botAI) : Multiplier(botAI, "arena ml") {}
+
+        float GetValue(Action* action) override
+        {
+            Player* bot = botAI->GetBot();
+            if (sPlayerbotAIConfig.ArenaMlTeams.empty() || !bot->InArena() ||
+                !sPlayerbotAIConfig.ArenaMlTeams.count(bot->GetArenaTeamId(0)))
+                return 1.0f;
+
+            PolicyNet const& net = Policy();
+            if (!net.ok)
+                return 1.0f;
+
+            auto const it = net.index.find(action->getName());
+            if (it == net.index.end())
+                return 1.0f;  // action the policy never saw: leave it to the rules
+
+            uint64 const now = GameTime::GetGameTimeMS().count();
+            if (now != lastTick)  // one forward pass per engine tick, not per candidate action
+            {
+                probs = net.Probabilities(Features(CollectObservation(botAI)));
+                top = *std::max_element(probs.begin(), probs.end());
+                lastTick = now;
+            }
+            // Most likely action x1.75, unlikely ones down to x0.25; never 0, so the rules still decide edge cases
+            return 0.25f + 1.5f * probs[it->second] / top;
+        }
+
+    private:
+        uint64 lastTick = 0;
+        std::vector<float> probs;
+        float top = 1.0f;
+    };
+}
+
+#endif
