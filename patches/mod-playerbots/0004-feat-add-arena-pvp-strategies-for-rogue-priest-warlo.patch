+class CastCycloneOnEnemyDpsAction : public CastSpellAction
+{
+public:
+    CastCycloneOnEnemyDpsAction(PlayerbotAI* botAI) : CastSpellAction(botAI, "cyclone") {}
+
+    Unit* GetTarget() override { return ai::arena::FindEnemyDps(botAI); }
+
+    bool isUseful() override
+    {
+        Unit* dps = GetTarget();
+        if (!dps || !dps->IsAlive())
+            return false;
+
+        if (dps->HasUnitState(UNIT_STATE_CYCLONED) || botAI->HasAura("cyclone", dps))
+            return false;
+
+        if (dps->GetDiminishing(DIMINISHING_CYCLONE) >= DIMINISHING_LEVEL_IMMUNE)
+            return false;
+
+        return CastSpellAction::isUseful();
+    }
+};
+
+class CastEntanglingRootsOnMeleeAction : public CastSpellAction
+{
+public:
+    CastEntanglingRootsOnMeleeAction(PlayerbotAI* botAI)
+        : CastSpellAction(botAI, "entangling roots") {}
+
+    Unit* GetTarget() override
+    {
+        Unit* dps = ai::arena::FindEnemyDps(botAI);
+        if (dps && dps->IsAlive())
+            return dps;
+
+        return AI_VALUE(Unit*, "current attacker");
+    }
+
+    bool isUseful() override
+    {
+        Unit* target = GetTarget();
+        if (!target || !target->IsAlive())
+            return false;
+
+        if (target->HasUnitState(UNIT_STATE_ROOT) || botAI->HasAura("entangling roots", target))
+            return false;
+
+        if (target->GetDiminishing(DIMINISHING_CONTROLLED_ROOT) >= DIMINISHING_LEVEL_IMMUNE)
+            return false;
+
+        return CastSpellAction::isUseful();
+    }
+};
