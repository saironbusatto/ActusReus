+bool FearEnemyHealerTrigger::IsActive()
+{
+    Unit* healer = ai::arena::FindEnemyHealer(botAI);
+    if (!healer || !healer->IsAlive() || !bot->IsWithinDistInMap(healer, 30.0f))
+        return false;
+
+    if (healer->HasUnitState(UNIT_STATE_FEARED) ||
+        healer->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+        healer->HasAuraType(SPELL_AURA_MOD_CONFUSE))
+        return false;
+
+    if (healer->GetDiminishing(DIMINISHING_FEAR) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("fear", healer);
+}
+
+bool HowlOfTerrorTrigger::IsActive()
+{
+    if (ai::arena::CountEnemiesNear(botAI, 10.0f) < 2)
+        return false;
+
+    return botAI->CanCastSpell("howl of terror", bot);
+}
+
+bool DeathCoilTrigger::IsActive()
+{
+    Unit* dps = ai::arena::FindEnemyDps(botAI);
+    Unit* target = nullptr;
+
+    if (dps && dps->IsAlive() && bot->IsWithinDistInMap(dps, 10.0f))
+        target = dps;
+    else if (bot->GetHealthPct() < 60.0f)
+        target = AI_VALUE(Unit*, "current target");
+
+    if (!target || !target->IsAlive())
+        return false;
+
+    if (target->GetDiminishing(DIMINISHING_HORROR) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("death coil", target);
+}
+
+bool CurseOfTonguesOnCasterTrigger::IsActive()
+{
+    Unit* caster = ai::arena::FindEnemyCaster(botAI);
+    if (!caster || !caster->IsAlive() || !bot->IsWithinDistInMap(caster, 30.0f))
+        return false;
+
+    if (botAI->HasAura("curse of tongues", caster))
+        return false;
+
+    return botAI->CanCastSpell("curse of tongues", caster);
+}
