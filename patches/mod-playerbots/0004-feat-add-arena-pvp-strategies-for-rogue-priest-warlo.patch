 public:
     CastDeathCoilAction(PlayerbotAI* botAI) : CastSpellAction(botAI, "death coil") {}
+
+    Unit* GetTarget() override
+    {
+        Unit* dps = ai::arena::FindEnemyDps(botAI);
+        if (dps && dps->IsAlive() && botAI->GetBot()->IsWithinDistInMap(dps, 10.0f))
+            return dps;
+
+        Unit* attacker = AI_VALUE(Unit*, "current attacker");
+        if (attacker && attacker->IsAlive() && botAI->GetBot()->IsWithinDistInMap(attacker, 10.0f))
+            return attacker;
+
+        return CastSpellAction::GetTarget();
+    }
+
+    bool isUseful() override
+    {
+        Unit* target = GetTarget();
+        if (!target || !target->IsAlive())
+            return false;
+
+        if (target->GetDiminishing(DIMINISHING_HORROR) >= DIMINISHING_LEVEL_IMMUNE)
+            return false;
+
+        return CastSpellAction::isUseful();
+    }
 };
 
