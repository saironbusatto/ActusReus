@@ -0,0 +1,118 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "ArenaRogueStrategy.h"
+#include "Playerbots.h"
+
+class ArenaRogueStrategyActionNodeFactory : public NamedObjectFactory<ActionNode>
+{
+public:
+    ArenaRogueStrategyActionNodeFactory()
+    {
+        creators["sinister strike"] = &sinister_strike;
+        creators["mutilate"] = &mutilate;
+    }
+
+private:
+    static ActionNode* sinister_strike([[maybe_unused]] PlayerbotAI* botAI)
+    {
+        return new ActionNode(
+            "sinister strike",
+            /*P*/ {},
+            /*A*/ { NextAction("hemorrhage") },
+            /*C*/ {}
+        );
+    }
+    static ActionNode* mutilate([[maybe_unused]] PlayerbotAI* botAI)
+    {
+        return new ActionNode(
+            "mutilate",
+            /*P*/ {},
+            /*A*/ { NextAction("hemorrhage") },
+            /*C*/ {}
+        );
+    }
+};
+
+ArenaRogueStrategy::ArenaRogueStrategy(PlayerbotAI* botAI) : CombatStrategy(botAI)
+{
+    actionNodeFactories.Add(new ArenaRogueStrategyActionNodeFactory());
+}
+
+void ArenaRogueStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    CombatStrategy::InitTriggers(triggers);
+
+    // Manual §2: Kick on enemy healer's cast
+    triggers.push_back(
+        new TriggerNode(
+            "kick on enemy healer",
+            {
+                NextAction("kick on enemy healer", ACTION_INTERRUPT + 2)
+            }
+        )
+    );
+
+    // Manual §2.3: Blind on enemy healer when partner is stunned (never on target with DoT/bleed)
+    triggers.push_back(
+        new TriggerNode(
+            "blind on enemy healer",
+            {
+                NextAction("blind on enemy healer", ACTION_INTERRUPT + 1)
+            }
+        )
+    );
+
+    // Manual §2: Shadowstep to close distance when out of melee
+    triggers.push_back(
+        new TriggerNode(
+            "enemy out of melee",
+            {
+                NextAction("shadowstep", ACTION_MOVE + 10)
+            }
+        )
+    );
+
+    // Manual §2: Cheap Shot -> Kidney Shot combo
+    triggers.push_back(
+        new TriggerNode(
+            "kidney shot",
+            {
+                NextAction("kidney shot", ACTION_HIGH + 5)
+            }
+        )
+    );
+
+    // Manual §2.3: Finisher Eviscerate (does not leave bleeds, safe before Blind)
+    triggers.push_back(
+        new TriggerNode(
+            "combo points 5 available",
+            {
+                NextAction("eviscerate", ACTION_HIGH + 4)
+            }
+        )
+    );
+
+    // Manual §2: Hemorrhage instead of Sinister Strike to build combo points
+    triggers.push_back(
+        new TriggerNode(
+            "combo points not full",
+            {
+                NextAction("hemorrhage", ACTION_NORMAL + 4)
+            }
+        )
+    );
+
+    // Manual §2.6: Preparation when Vanish on CD
+    triggers.push_back(
+        new TriggerNode(
+            "vanish on cd",
+            {
+                NextAction("preparation", ACTION_EMERGENCY)
+            }
+        )
+    );
+}
