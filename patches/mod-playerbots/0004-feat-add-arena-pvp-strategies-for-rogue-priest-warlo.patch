@@ -0,0 +1,193 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "ArenaDruidStrategy.h"
+#include "ArenaHelpers.h"
+#include "Playerbots.h"
+
+class ArenaDruidStrategyActionNodeFactory : public NamedObjectFactory<ActionNode>
+{
+public:
+    ArenaDruidStrategyActionNodeFactory()
+    {
+        creators["cyclone on enemy dps"] = &cyclone_on_enemy_dps;
+        creators["entangling roots on melee"] = &entangling_roots_on_melee;
+    }
+
+private:
+    static ActionNode* cyclone_on_enemy_dps([[maybe_unused]] PlayerbotAI* botAI)
+    {
+        return new ActionNode("cyclone on enemy dps",
+                              /*P*/ { NextAction("caster form") },
+                              /*A*/ {},
+                              /*C*/ {});
+    }
+
+    static ActionNode* entangling_roots_on_melee([[maybe_unused]] PlayerbotAI* botAI)
+    {
+        return new ActionNode("entangling roots on melee",
+                              /*P*/ { NextAction("caster form") },
+                              /*A*/ {},
+                              /*C*/ {});
+    }
+};
+
+ArenaDruidStrategy::ArenaDruidStrategy(PlayerbotAI* botAI) : GenericDruidStrategy(botAI)
+{
+    actionNodeFactories.Add(new ArenaDruidStrategyActionNodeFactory());
+}
+
+void ArenaDruidStrategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
+{
+    GenericDruidStrategy::InitMultipliers(multipliers);
+    multipliers.push_back(new ArenaDruidMultiplier(botAI));
+}
+
+float ArenaDruidMultiplier::GetValue(Action* action)
+{
+    if (!action)
+        return 1.0f;
+
+    std::string const name = action->getName();
+    // Do not waste GCD with Wrath/Moonfire/Starfire/Insect Swarm while ally needs healing
+    if (name == "wrath" || name == "moonfire" || name == "starfire" ||
+        name == "insect swarm" || name == "cancel tree form")
+    {
+        Unit* toHeal = AI_VALUE(Unit*, "party member to heal");
+        if (toHeal && toHeal->GetHealthPct() < 85.0f)
+            return 0.0f;
+
+        Unit* partner = ai::arena::FindPartner(botAI);
+        if (partner && partner->GetHealthPct() < 85.0f)
+            return 0.0f;
+
+        if (botAI->GetBot()->GetHealthPct() < 85.0f)
+            return 0.0f;
+    }
+
+    return 1.0f;
+}
+
+void ArenaDruidStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    GenericDruidStrategy::InitTriggers(triggers);
+
+    // Defensive: Barkskin below ~50% health
+    triggers.push_back(
+        new TriggerNode(
+            "low health",
+            {
+                NextAction("barkskin", 55.0f)
+            }
+        )
+    );
+
+    // CC: Cyclone on enemy DPS when partner/self in danger
+    triggers.push_back(
+        new TriggerNode(
+            "cyclone on enemy dps",
+            {
+                NextAction("cyclone on enemy dps", 52.0f)
+            }
+        )
+    );
+
+    // CC: Entangling Roots on melee enemy
+    triggers.push_back(
+        new TriggerNode(
+            "roots on melee",
+            {
+                NextAction("entangling roots on melee", 48.0f)
+            }
+        )
+    );
+
+    // Emergency Nature's Swiftness + Healing Touch
+    triggers.push_back(
+        new TriggerNode(
+            "party member critical health",
+            {
+                NextAction("nature's swiftness", 60.0f)
+            }
+        )
+    );
+    triggers.push_back(
+        new TriggerNode(
+            "nature's swiftness active",
+            {
+                NextAction("healing touch on party", 58.0f)
+            }
+        )
+    );
+
+    // Reach party member to heal
+    triggers.push_back(
+        new TriggerNode(
+            "party member to heal out of spell range",
+            {
+                NextAction("reach party member to heal", 40.0f)
+            }
+        )
+    );
+
+    // Healing rotations
+    triggers.push_back(
+        new TriggerNode(
+            "party member critical health",
+            {
+                NextAction("swiftmend on party", 45.0f),
+                NextAction("nourish on party", 44.0f),
+                NextAction("regrowth on party", 43.0f),
+                NextAction("tree form", 42.0f)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "party member low health",
+            {
+                NextAction("swiftmend on party", 35.0f),
+                NextAction("wild growth on party", 34.0f),
+                NextAction("nourish on party", 33.0f),
+                NextAction("regrowth on party", 32.0f),
+                NextAction("tree form", 31.0f)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "party member medium health",
+            {
+                NextAction("swiftmend on party", 25.0f),
+                NextAction("wild growth on party", 24.0f),
+                NextAction("nourish on party", 23.0f),
+                NextAction("rejuvenation on party", 22.0f),
+                NextAction("regrowth on party", 21.0f)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "party member almost full health",
+            {
+                NextAction("rejuvenation on party", 15.0f),
+                NextAction("wild growth on party", 14.0f)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "medium mana",
+            {
+                NextAction("innervate", 29.0f)
+            }
+        )
+    );
+}
