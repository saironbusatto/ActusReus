@@ -0,0 +1,121 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "ArenaPriestStrategy.h"
+#include "Playerbots.h"
+
+float ArenaPriestMultiplier::GetValue(Action* action)
+{
+    if (!action)
+        return 1.0f;
+
+    // Manual §3.7: Wand only when there is nothing better to do (e.g. no healing needed)
+    if (action->getName() == "shoot")
+    {
+        if (AI_VALUE(Unit*, "party member to heal"))
+            return 0.0f;
+    }
+
+    return 1.0f;
+}
+
+ArenaPriestStrategy::ArenaPriestStrategy(PlayerbotAI* botAI) : GenericPriestStrategy(botAI)
+{
+}
+
+std::vector<NextAction> ArenaPriestStrategy::getDefaultActions()
+{
+    return {
+        NextAction("shoot", ACTION_BG)
+    };
+}
+
+void ArenaPriestStrategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
+{
+    GenericPriestStrategy::InitMultipliers(multipliers);
+    multipliers.push_back(new ArenaPriestMultiplier(botAI));
+}
+
+void ArenaPriestStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    GenericPriestStrategy::InitTriggers(triggers);
+
+    // Manual §3: Silence on enemy healer's cast
+    triggers.push_back(
+        new TriggerNode(
+            "silence on enemy healer",
+            {
+                NextAction("silence on enemy healer", ACTION_INTERRUPT + 2)
+            }
+        )
+    );
+
+    // Manual §3: Psychic Scream when melee enemies are close
+    triggers.push_back(
+        new TriggerNode(
+            "enemy within melee",
+            {
+                NextAction("psychic scream", ACTION_HIGH + 9),
+                NextAction("psychic horror", ACTION_HIGH + 8)
+            }
+        )
+    );
+
+    // Manual §3: Pain Suppression when partner (or self) is critically low (< ~35%)
+    triggers.push_back(
+        new TriggerNode(
+            "critical health",
+            {
+                NextAction("pain suppression", ACTION_EMERGENCY + 5),
+                NextAction("desperate prayer", ACTION_EMERGENCY + 4),
+                NextAction("power word: shield", ACTION_EMERGENCY + 3)
+            }
+        )
+    );
+    triggers.push_back(
+        new TriggerNode(
+            "party member critical health",
+            {
+                NextAction("pain suppression on party", ACTION_EMERGENCY + 5),
+                NextAction("power word: shield on party", ACTION_CRITICAL_HEAL + 5),
+                NextAction("penance on party", ACTION_CRITICAL_HEAL + 4),
+                NextAction("prayer of mending on party", ACTION_CRITICAL_HEAL + 3),
+                NextAction("flash heal on party", ACTION_CRITICAL_HEAL + 2)
+            }
+        )
+    );
+
+    // Healing rotation for partner
+    triggers.push_back(
+        new TriggerNode(
+            "party member low health",
+            {
+                NextAction("power word: shield on party", ACTION_MEDIUM_HEAL + 5),
+                NextAction("penance on party", ACTION_MEDIUM_HEAL + 4),
+                NextAction("flash heal on party", ACTION_MEDIUM_HEAL + 2)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "party member medium health",
+            {
+                NextAction("power word: shield on party", ACTION_LIGHT_HEAL + 6),
+                NextAction("renew on party", ACTION_LIGHT_HEAL + 5)
+            }
+        )
+    );
+
+    triggers.push_back(
+        new TriggerNode(
+            "party member almost full health",
+            {
+                NextAction("renew on party", ACTION_LIGHT_HEAL + 2)
+            }
+        )
+    );
+}
