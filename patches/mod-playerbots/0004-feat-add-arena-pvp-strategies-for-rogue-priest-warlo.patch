+bool BlindEnemyHealerTrigger::IsActive()
+{
+    Unit* healer = ai::arena::FindEnemyHealer(botAI);
+    if (!healer || !bot->IsWithinDistInMap(healer, 15.0f))
+        return false;
+
+    if (healer->HasAuraType(SPELL_AURA_PERIODIC_DAMAGE) ||
+        healer->HasAuraType(SPELL_AURA_PERIODIC_DAMAGE_PERCENT) ||
+        healer->HasAuraWithMechanic(1 << MECHANIC_BLEED))
+        return false;
+
+    if (healer->HasAuraType(SPELL_AURA_MOD_CONFUSE) || healer->HasAuraType(SPELL_AURA_MOD_FEAR))
+        return false;
+
+    if (healer->GetDiminishing(DIMINISHING_FEAR) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    Unit* partner = ai::arena::FindEnemyDps(botAI);
+    if (!partner || !partner->HasUnitState(UNIT_STATE_STUNNED))
+        return false;
+
+    return botAI->CanCastSpell("blind", healer);
+}
+
+bool KidneyShotTrigger::IsActive()
+{
+    Unit* target = GetTarget();
+    if (!target || !bot->IsWithinMeleeRange(target))
+        return false;
+
+    if (AI_VALUE2(uint8, "combo", "current target") < 2)
+        return false;
+
+    if (botAI->HasAura("kidney shot", target))
+        return false;
+
+    Aura* csAura = botAI->GetAura("cheap shot", target);
+    if (csAura && csAura->GetDuration() > 1000)
+        return false;
+
+    return SpellCanBeCastTrigger::IsActive();
+}
