+
+#ifndef PLAYERBOTS_ARENAHELPERS_H
+#define PLAYERBOTS_ARENAHELPERS_H
+
+#include "AiFactory.h"
+#include "Group.h"
+#include "ObjectAccessor.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "SharedDefines.h"
+
+namespace ai::arena
+{
+    inline Unit* FindEnemyHealer(PlayerbotAI* botAI)
+    {
+        GuidVector attackers = botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get();
+        for (ObjectGuid const guid : attackers)
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (!u || !u->IsAlive() || !u->IsPlayer())
+                continue;
+
+            Player* p = u->ToPlayer();
+            uint8 cls = p->getClass();
+            if (cls == CLASS_PRIEST)
+                return u;
+            if (cls == CLASS_DRUID && AiFactory::GetPlayerSpecTab(p) == DRUID_TAB_RESTORATION)
+                return u;
+            if (cls == CLASS_PALADIN && AiFactory::GetPlayerSpecTab(p) == PALADIN_TAB_HOLY)
+                return u;
+            if (cls == CLASS_SHAMAN && AiFactory::GetPlayerSpecTab(p) == SHAMAN_TAB_RESTORATION)
+                return u;
+        }
+        return nullptr;
+    }
+
+    inline Unit* FindEnemyDps(PlayerbotAI* botAI)
+    {
+        GuidVector attackers = botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get();
+        Unit* healer = FindEnemyHealer(botAI);
+        for (ObjectGuid const guid : attackers)
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (!u || !u->IsAlive() || !u->IsPlayer())
+                continue;
+
+            if (u != healer)
+                return u;
+        }
+        return nullptr;
+    }
+
+    inline Unit* FindEnemyCaster(PlayerbotAI* botAI)
+    {
+        GuidVector attackers = botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get();
+        for (ObjectGuid const guid : attackers)
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (!u || !u->IsAlive() || !u->IsPlayer())
+                continue;
+
+            Player* p = u->ToPlayer();
+            uint8 cls = p->getClass();
+            if (cls == CLASS_PRIEST || cls == CLASS_MAGE || cls == CLASS_WARLOCK ||
+                cls == CLASS_DRUID || cls == CLASS_SHAMAN)
+                return u;
+        }
+        return nullptr;
+    }
+
+    inline Unit* FindPartner(PlayerbotAI* botAI)
+    {
+        Player* bot = botAI->GetBot();
+        Group* group = bot->GetGroup();
+        if (!group)
+            return nullptr;
+
+        Group::MemberSlotList const& members = group->GetMemberSlots();
+        for (auto const& slot : members)
+        {
+            if (slot.guid != bot->GetGUID())
+            {
+                Player* p = ObjectAccessor::FindPlayer(slot.guid);
+                if (p && p->IsAlive())
+                    return p;
+            }
+        }
+        return nullptr;
+    }
+
+    inline uint8 CountEnemiesNear(PlayerbotAI* botAI, float range)
+    {
+        GuidVector attackers = botAI->GetAiObjectContext()->GetValue<GuidVector>("attackers")->Get();
+        Player* bot = botAI->GetBot();
+        uint8 count = 0;
+        for (ObjectGuid const guid : attackers)
+        {
+            Unit* u = botAI->GetUnit(guid);
+            if (u && u->IsAlive() && bot->IsWithinDistInMap(u, range))
+                count++;
+        }
+        return count;
+    }
+}
+
+#endif
