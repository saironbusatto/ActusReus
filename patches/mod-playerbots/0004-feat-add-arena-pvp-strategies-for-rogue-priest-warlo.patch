+bool CycloneEnemyDpsTrigger::IsActive()
+{
+    Unit* partner = ai::arena::FindPartner(botAI);
+    bool inDanger = (partner && partner->GetHealthPct() < 50.0f) || (bot->GetHealthPct() < 50.0f);
+    if (!inDanger)
+        return false;
+
+    Unit* dps = ai::arena::FindEnemyDps(botAI);
+    if (!dps || !dps->IsAlive() || !bot->IsWithinDistInMap(dps, 20.0f))
+        return false;
+
+    if (dps->HasUnitState(UNIT_STATE_CYCLONED) || botAI->HasAura("cyclone", dps))
+        return false;
+
+    if (dps->GetDiminishing(DIMINISHING_CYCLONE) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("cyclone", dps);
+}
+
+bool RootsOnMeleeTrigger::IsActive()
+{
+    Unit* dps = ai::arena::FindEnemyDps(botAI);
+    if (!dps || !dps->IsAlive() || !bot->IsWithinDistInMap(dps, 30.0f))
+        return false;
+
+    if (dps->HasUnitState(UNIT_STATE_ROOT) || botAI->HasAura("entangling roots", dps))
+        return false;
+
+    if (dps->GetDiminishing(DIMINISHING_CONTROLLED_ROOT) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("entangling roots", dps);
+}
