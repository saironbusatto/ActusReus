diff --git a/src/Ai/Class/Warrior/WarriorActions.h b/src/Ai/Class/Warrior/WarriorActions.h
index c3a612e3..329867dc 100644
--- a/src/Ai/Class/Warrior/WarriorActions.h
+++ b/src/Ai/Class/Warrior/WarriorActions.h
@@ -89,7 +89,24 @@ public:
     bool isUseful() override;
 };
 MELEE_ACTION(CastWhirlwindAction, "whirlwind");
-MELEE_ACTION(CastPummelAction, "pummel");
+class CastPummelAction : public CastMeleeSpellAction
+{
+public:
+    CastPummelAction(PlayerbotAI* botAI) : CastMeleeSpellAction(botAI, "pummel") {}
+
+    // The spell check refuses Pummel outside Berserker Stance, and the engine only runs the stance prerequisite of a
+    // possible action, so an Arms warrior in an arena needs this to stance dance into the interrupt.
+    bool isPossible() override
+    {
+        constexpr uint32 SPELL_PUMMEL = 6552;
+        constexpr uint32 SPELL_BERSERKER_STANCE = 2458;
+        constexpr uint32 PUMMEL_RAGE = 100;
+
+        return CastMeleeSpellAction::isPossible() ||
+               (bot->InArena() && !bot->HasAura(SPELL_BERSERKER_STANCE) && !bot->HasSpellCooldown(SPELL_PUMMEL) &&
+                bot->GetPower(POWER_RAGE) >= PUMMEL_RAGE);
+    }
+};
 ENEMY_HEALER_ACTION(CastPummelOnEnemyHealerAction, "pummel");
 // fury 2.4.3
 MELEE_ACTION(CastVictoryRushAction, "victory rush");
