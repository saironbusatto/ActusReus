+
+// Arena: slow the enemy melee so the warlock can kite and keep casting (manual §4.5)
+bool CurseOfExhaustionOnMeleeTrigger::IsActive()
+{
+    if (!bot->InArena())
+        return false;
+
+    Unit* dps = ai::arena::FindEnemyDps(botAI);
+    if (!dps || !dps->IsPlayer() || !bot->IsWithinDistInMap(dps, 30.0f))
+        return false;
+
+    uint8 const cls = dps->ToPlayer()->getClass();
+    if (cls != CLASS_ROGUE && cls != CLASS_WARRIOR && cls != CLASS_DEATH_KNIGHT && cls != CLASS_PALADIN)
+        return false;
+
+    return !botAI->HasAura("curse of exhaustion", dps) && botAI->CanCastSpell("curse of exhaustion", dps);
+}
