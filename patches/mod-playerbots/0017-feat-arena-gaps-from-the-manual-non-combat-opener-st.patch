+bool FearWardVsWarlockTrigger::IsActive()
+{
+    if (!bot->InArena() || botAI->HasAura("fear ward", bot))
+        return false;
+
+    for (ObjectGuid const guid : AI_VALUE(GuidVector, "possible targets"))
+    {
+        Unit* u = botAI->GetUnit(guid);
+        if (u && u->IsAlive() && u->IsPlayer() && u->ToPlayer()->getClass() == CLASS_WARLOCK)
+            return botAI->CanCastSpell("fear ward", bot);
+    }
+    return false;
+}
