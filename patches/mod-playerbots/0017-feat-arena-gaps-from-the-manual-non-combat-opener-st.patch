+// Arena opener: Sap the healer (the player who will sit in CC) before the fight starts
+bool SapEnemyHealerTrigger::IsActive()
+{
+    if (!bot->InArena() || !botAI->HasAura("stealth", bot))
+        return false;
+
+    Unit* healer = ai::arena::FindVisibleEnemyHealer(botAI);
+    if (!healer || healer->IsInCombat() || !bot->IsWithinDistInMap(healer, 10.0f) ||
+        healer->GetDiminishing(DIMINISHING_DISORIENT) >= DIMINISHING_LEVEL_IMMUNE)
+        return false;
+
+    return botAI->CanCastSpell("sap", healer);
+}
+
+// Shadow Dance: after the Cheap Shot lands, Ambush (guaranteed crit with the talent) on the stunned target
+bool DanceAmbushTrigger::IsActive()
+{
+    Unit* target = AI_VALUE(Unit*, "current target");
+    return target && botAI->HasAura("shadow dance", bot) && target->HasUnitState(UNIT_STATE_STUNNED) &&
+           botAI->CanCastSpell("ambush", target);
+}
