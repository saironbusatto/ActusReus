diff --git a/src/Ai/Base/ArenaHelpers.h b/src/Ai/Base/ArenaHelpers.h
index 99350a7b..d773927d 100644
--- a/src/Ai/Base/ArenaHelpers.h
+++ b/src/Ai/Base/ArenaHelpers.h
@@ -107,6 +107,23 @@ namespace ai::arena
         return count;
     }
 
+    // Enemy healer among visible enemies, also before combat starts ("attackers" is empty then)
+    inline Unit* FindVisibleEnemyHealer(PlayerbotAI* botAI)
+    {
+        for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("possible targets")->Get())
+        {
+            Unit* u = botAI->GetUnit(guid);
+            Player* p = u ? u->ToPlayer() : nullptr;
+            if (!p || !p->IsAlive())
+                continue;
+
+            if (p->getClass() == CLASS_PRIEST ||
+                (p->getClass() == CLASS_DRUID && AiFactory::GetPlayerSpecTab(p) == DRUID_TAB_RESTORATION))
+                return p;
+        }
+        return nullptr;
+    }
+
     // CC break still available (PvP trinket equipped and off cooldown, or Every Man for Himself)
     inline bool HasCcBreakReady(Unit* u)
     {
@@ -154,8 +171,14 @@ namespace ai::arena
         static char const* const ccSpells[] = {"blind", "fear", "cyclone", "psychic scream", "death coil", "gouge"};
         Unit* partner = FindPartner(botAI);
         PlayerbotAI* partnerAI = partner ? GET_PLAYERBOT_AI(partner->ToPlayer()) : nullptr;
+        // Will of the Forsaken ready breaks Fear/Psychic Scream: those do not hold an Undead
+        Player* ccPlayer = cc->ToPlayer();
+        bool const wotfReady = ccPlayer && ccPlayer->getRace() == RACE_UNDEAD_PLAYER && !ccPlayer->HasSpellCooldown(7744);
         for (char const* spell : ccSpells)
         {
+            if (wotfReady && (std::string(spell) == "fear" || std::string(spell) == "psychic scream"))
+                continue;
+
             if (botAI->CanCastSpell(spell, cc) || (partnerAI && partnerAI->CanCastSpell(spell, cc)))
                 return true;
         }
