+// Arena (Lamures plan, 2009): Mana Burn the enemy healer while the partner pressures the DPS
+class CastManaBurnOnEnemyHealerAction : public CastSpellAction
+{
+public:
+    CastManaBurnOnEnemyHealerAction(PlayerbotAI* botAI) : CastSpellAction(botAI, "mana burn") {}
+
+    Unit* GetTarget() override { return ai::arena::FindEnemyHealer(botAI); }
+    bool isUseful() override
+    {
+        Unit* healer = GetTarget();
+        return healer && healer->getPowerType() == POWER_MANA && healer->GetPowerPct(POWER_MANA) > 10.0f &&
+               bot->GetPowerPct(POWER_MANA) > 40.0f;
+    }
+};
+
+// Manual §3.6: Fear Ward on self against a warlock
