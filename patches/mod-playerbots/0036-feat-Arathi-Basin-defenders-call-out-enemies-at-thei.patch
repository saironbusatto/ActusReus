 src/Ai/Base/ActionContext.h                   |  3 +
 src/Ai/Base/Actions/AbOrderAction.cpp         | 77 +++++++++++++++++++
 src/Ai/Base/Actions/AbOrderAction.h           | 15 ++++
 src/Ai/Base/Strategy/BattlegroundStrategy.cpp |  2 +
 src/PlayerbotAIConfig.cpp                     |  1 +
 src/PlayerbotAIConfig.h                       |  1 +
 7 files changed, 109 insertions(+)

