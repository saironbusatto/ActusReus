 }
+
+namespace
+{
+    // The node (BG_AB_NODE_*) this bot was ordered to, when the order belongs to this battleground; -1 otherwise
+    int OrderedNode(Battleground* bg, uint32 order)
+    {
+        return order && (order >> 3) == bg->GetInstanceID() ? int(order & 7) - 1 : -1;
+    }
+}
+
+bool AbCalloutAction::isUseful()
+{
+    if (!sPlayerbotAIConfig.AbDefenderCallouts || !bot->IsAlive())
+        return false;
+
+    Battleground* bg = bot->GetBattleground();
+    return bg && bg->GetBgTypeID() == BATTLEGROUND_AB && bg->GetStatus() == STATUS_IN_PROGRESS &&
+           OrderedNode(bg, context->GetValue<uint32>("ab order")->Get()) >= 0;
+}
+
+bool AbCalloutAction::Execute(Event /*event*/)
+{
+    static char const* const names[] = {"Estábulo", "Ferreiro", "Fazenda", "Serraria", "Mina"};
+    float constexpr watch = 50.0f;  // yards around the flag
+
+    Battleground* bg = bot->GetBattleground();
+    int const node = OrderedNode(bg, context->GetValue<uint32>("ab order")->Get());
+    GameObject* flag = bg->GetBGObject(node * BG_AB_OBJECTS_PER_NODE);
+    if (!flag || !bot->IsWithinDist(flag, watch))
+        return false;  // still on the way: only a group holding the node speaks
+
+    // One speaker per raid subgroup: the lowest guid alive at the node
+    bool inCombat = bot->IsInCombat();
+    if (Group* group = bot->GetGroup())
+    {
+        uint8 const sub = group->GetMemberGroup(bot->GetGUID());
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || member == bot || !member->IsAlive() || group->GetMemberGroup(member->GetGUID()) != sub ||
+                !member->IsWithinDist(flag, watch))
+                continue;
+
+            if (member->GetGUID() < bot->GetGUID())
+                return false;
+            inCombat = inCombat || member->IsInCombat();
+        }
+    }
+
+    uint32 count = 0;
+    for (auto const& [guid, player] : bg->GetPlayers())  // at most 30 players in Arathi Basin
+        if (player && player->IsAlive() && player->GetBgTeamId() != bot->GetBgTeamId() &&
+            player->IsWithinDist(flag, watch) && bot->CanSeeOrDetect(player))  // stealth still hides
+            ++count;
+
+    time_t const now = time(nullptr);
+    std::string text;
+    if (count && (count > lastCount || now - lastCallout >= 20))
+        text = PlayerbotTextMgr::instance().GetBotTextOrDefault(
+            inCombat ? "ab_node_under_attack" : "ab_node_threat",
+            inCombat ? "%node SOB ATAQUE: %count inimigo(s)!" : "%node: %count inimigo(s) chegando",
+            {{"%node", names[node]}, {"%count", std::to_string(count)}});
+    else if (!count && lastCount)
+        text = PlayerbotTextMgr::instance().GetBotTextOrDefault("ab_node_clear", "%node limpo", {{"%node", names[node]}});
+
+    lastCount = count;
+    if (text.empty())
+        return false;
+
+    lastCallout = now;
+    return botAI->SayToRaid(text);
+}
diff --git a/src/Ai/Base/Actions/AbOrderAction.h b/src/Ai/Base/Actions/AbOrderAction.h
index 336839d7..fd227d38 100644
--- a/src/Ai/Base/Actions/AbOrderAction.h
+++ b/src/Ai/Base/Actions/AbOrderAction.h
@@ -26,4 +26,19 @@ public:
     static int ParseTarget(std::string const& word);
 };
 
+// A group holding a node by order calls out in raid chat when enemies show up there, so the leader can send help.
+// One speaker per raid subgroup (lowest guid alive at the node), at most every 20 s unless more enemies arrive.
+class AbCalloutAction : public Action
+{
+public:
+    AbCalloutAction(PlayerbotAI* botAI) : Action(botAI, "ab callout") {}
+
+    bool Execute(Event event) override;
+    bool isUseful() override;
+
+private:
+    time_t lastCallout = 0;
+    uint32 lastCount = 0;
+};
+
 #endif
