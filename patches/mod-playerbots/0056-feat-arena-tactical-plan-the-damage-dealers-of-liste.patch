+#
+#    Playerbots.ArenaPlanTeams
+#    Playerbots.ArenaPlanFile
+#        Tactical plan for the damage dealers of the listed arena teams (comma-separated ids): while the
+#        plan's kill target of the matchup can be hit (alive, seen, in line of sight within 40 yd, not
+#        immune, not in a teammate's breakable CC) it is their target; otherwise the rules pick as usual.
+#        The file has one line per matchup, "<own class ids>|<enemy class ids>=<kill class id>" with each
+#        side's class ids sorted, e.g. "4,5,8|4,7,9=9" (Rogue/Priest/Mage vs Rogue/Shaman/Warlock: kill the
+#        Warlock). Both are re-read every 10 s.
+#        Default: "" - No plan (the rules pick targets)
+#
+
+Playerbots.ArenaPlanTeams = ""
+Playerbots.ArenaPlanFile = ""
+
