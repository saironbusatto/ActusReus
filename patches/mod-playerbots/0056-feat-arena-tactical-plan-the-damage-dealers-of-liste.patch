+    // The enemy the tactical plan wants dead (its kill-target class in this matchup), for a damage dealer of a
+    // Playerbots.ArenaPlanTeams team, while it can be hit right now: alive, seen, in line of sight within 40 yd, not
+    // immune and not in a teammate's breakable CC. nullptr leaves targeting to the rules.
+    inline Unit* PlanKillTarget(PlayerbotAI* botAI)
+    {
+        Player* bot = botAI->GetBot();
+        Battleground* bg = bot->GetBattleground();
+        if (!bg || !bot->InArena() || PlayerbotAI::IsHeal(bot))
+            return nullptr;
+        MlPolicies& p = MlPolicies::Instance();
+        p.Refresh();
+        auto const s = p.Settings();
+        bool planned = false;
+        for (uint8 slot = 0; slot < 3; ++slot)  // 2v2, 3v3, 5v5 team slots
+            planned = planned || s->plan.count(bot->GetArenaTeamId(slot));
+        if (!planned || s->kill.empty())
+            return nullptr;
+
+        std::vector<uint8> ours, theirs;
+        std::vector<Player*> enemies;
+        for (auto const& [guid, bgPlayer] : bg->GetPlayers())
+        {
+            Player* player = ObjectAccessor::FindPlayer(guid);
+            if (!player)
+                continue;
+            if (player->GetBgTeamId() == bot->GetBgTeamId())
+                ours.push_back(player->getClass());
+            else
+            {
+                theirs.push_back(player->getClass());
+                enemies.push_back(player);
+            }
+        }
+        auto key = [](std::vector<uint8> classes)
+        {
+            std::sort(classes.begin(), classes.end());
+            std::string k;
+            for (uint8 c : classes)
+                k += (k.empty() ? "" : ",") + std::to_string(c);
+            return k;
+        };
+        auto const it = s->kill.find(key(ours) + "|" + key(theirs));
+        if (it == s->kill.end())
+            return nullptr;
+        for (Player* enemy : enemies)
+            if (enemy->getClass() == it->second && enemy->IsAlive() && bot->CanSeeOrDetect(enemy) &&
+                bot->IsWithinDist(enemy, 40.0f) && bot->IsWithinLOSInMap(enemy) &&
+                !enemy->HasAuraType(SPELL_AURA_SCHOOL_IMMUNITY) && !enemy->HasBreakableByDamageCrowdControlAura())
+                return enemy;
+        return nullptr;
+    }
+
