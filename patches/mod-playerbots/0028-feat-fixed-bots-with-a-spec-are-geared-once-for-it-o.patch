From f2d58579b7a27b8759e2f2a0f73195f76b9bd205 Mon Sep 17 00:00:00 2001
From: saironcb <saironbusatto@gmail.com>
Date: Wed, 21 Oct 2026 22:03:43 -0300
Subject: [PATCH 28/43] feat: fixed bots with a spec are geared once for it on
 first login (PvP weights for pvp specs), enchanted, gemmed, glyphed, pet

---
 src/Bot/RandomPlayerbotMgr.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/Bot/RandomPlayerbotMgr.cpp b/src/Bot/RandomPlayerbotMgr.cpp
index e9c81945..ceb034ca 100644
--- a/src/Bot/RandomPlayerbotMgr.cpp
+++ b/src/Bot/RandomPlayerbotMgr.cpp
@@ -1867,6 +1867,24 @@ void RandomPlayerbotMgr::ApplyFixedBotSpec(Player* player)
 
         // Glyphs stay as stored: InitGlyphs picks randomly and would break identical clones
         PlayerbotFactory::InitTalentsBySpecNo(player, specNo, true);
+
+        // First login of a fixed bot with a spec: gear it once for that spec (PvP weights when the spec name
+        // says "pvp"), enchant, gem, glyph and pet. Afterwards the gear stays frozen like the arena bots.
+        if (!GetEventValue(botId, "fixedgear"))
+        {
+            PlayerbotFactory factory(player, player->GetLevel());
+            factory.InitClassSpells();
+            factory.InitAvailableSpells();
+            factory.InitEquipment(false);
+            factory.ApplyEnchantAndGemsNew(true);
+            factory.InitGlyphs(false);
+            factory.InitAmmo();
+            factory.InitPet();
+            factory.InitPetTalents();
+            SetEventValue(botId, "fixedgear", 1, 365 * DAY);
+            LOG_INFO("playerbots", "Playerbots.FixedRandomBots: {} geared for '{}'", player->GetName(), itr->second);
+        }
+
         if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(player))
             botAI->ResetStrategies();
 
