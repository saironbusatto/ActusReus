diff --git a/src/Ai/Base/PetAbilities.h b/src/Ai/Base/PetAbilities.h
new file mode 100644
index 00000000..4e19c001
--- /dev/null
+++ b/src/Ai/Base/PetAbilities.h
@@ -0,0 +1,216 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#ifndef PLAYERBOTS_PETABILITIES_H
+#define PLAYERBOTS_PETABILITIES_H
+
+#include <cstring>
+#include <set>
+
+#include "Action.h"
+#include "Pet.h"
+#include "Playerbots.h"
+#include "SpellAuras.h"
+#include "SpellMgr.h"
+#include "Trigger.h"
+
+// Pet abilities a 2009 player used by hand (opt-in via Playerbots.SmartPetAbilities). The saved pets showed Spell
+// Lock and Devour Magic off on every Felhunter, Lash of Pain and Seduction off on most Succubi, and no bot code that
+// casts them, so Warlocks played without their interrupt and their CC.
+namespace ai::pet
+{
+    // Spell id of the pet ability with this (enUS) name, or 0
+    inline uint32 Spell(Pet* pet, char const* name)
+    {
+        if (!pet)
+            return 0;
+        for (auto const& [id, spell] : pet->m_spells)
+            if (spell.state != PETSPELL_REMOVED)
+                if (SpellInfo const* info = sSpellMgr->GetSpellInfo(id); info && !strcmp(info->SpellName[0], name))
+                    return id;
+        return 0;
+    }
+
+    inline uint32 ReadySpell(Pet* pet, char const* name)
+    {
+        uint32 const id = Spell(pet, name);
+        return id && pet->IsAlive() && !pet->HasSpellCooldown(id) && !pet->HasUnitState(UNIT_STATE_CASTING) ? id : 0;
+    }
+
+    // Seduction, Polymorph, Sap, Blind, Repentance, Hex...: damage on this unit would set it free
+    inline bool HasBreakOnDamageCc(Unit* unit)
+    {
+        for (auto const& [id, app] : unit->GetAppliedAuras())
+            if (!app->IsPositive() &&
+                (app->GetBase()->GetSpellInfo()->AuraInterruptFlags & AURA_INTERRUPT_FLAG_TAKE_DAMAGE))
+                return true;
+        return false;
+    }
+
+    // Enemy players the bot can see, alive and within range of the pet with line of sight from it
+    inline std::vector<Player*> EnemiesNearPet(PlayerbotAI* botAI, Pet* pet, float range)
+    {
+        std::vector<Player*> out;
+        for (ObjectGuid const guid : botAI->GetAiObjectContext()->GetValue<GuidVector>("possible targets")->Get())
+        {
+            Unit* unit = botAI->GetUnit(guid);
+            Player* player = unit ? unit->ToPlayer() : nullptr;
+            if (player && player->IsAlive() && pet->IsWithinDistInMap(player, range) && pet->IsWithinLOSInMap(player))
+                out.push_back(player);
+        }
+        return out;
+    }
+
+    inline Player* CastingEnemy(PlayerbotAI* botAI, Pet* pet, float range)
+    {
+        Player* best = nullptr;
+        for (Player* enemy : EnemiesNearPet(botAI, pet, range))
+            if (enemy->IsNonMeleeSpellCast(false) && (!best || PlayerbotAI::IsHeal(enemy)))  // healer first
+                best = enemy;
+        return best;
+    }
+
+    // Seduction target: the enemy healer, else another enemy that is not the kill target; never one already in CC
+    // or carrying a damage over time (it would break at once). Only with two or more enemies around.
+    inline Player* SeductionTarget(PlayerbotAI* botAI, Pet* pet)
+    {
+        Unit* kill = botAI->GetAiObjectContext()->GetValue<Unit*>("current target")->Get();
+        std::vector<Player*> const enemies = EnemiesNearPet(botAI, pet, 30.0f);
+        if (enemies.size() < 2)
+            return nullptr;
+
+        Player* best = nullptr;
+        for (Player* enemy : enemies)
+        {
+            if (enemy == kill || enemy->HasUnitState(UNIT_STATE_STUNNED) || enemy->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+                enemy->HasAuraType(SPELL_AURA_MOD_CONFUSE) || enemy->HasAuraType(SPELL_AURA_PERIODIC_DAMAGE) ||
+                HasBreakOnDamageCc(enemy))
+                continue;
+            if (!best || (PlayerbotAI::IsHeal(enemy) && !PlayerbotAI::IsHeal(best)))
+                best = enemy;
+        }
+        return best;
+    }
+}
+
+// Once per pet: autocast on for what plays itself, off for what needs judgment (cast below) or hurts in PvP
+class PetAutocastAction : public Action
+{
+public:
+    PetAutocastAction(PlayerbotAI* botAI) : Action(botAI, "pet autocast setup") {}
+
+    bool isUseful() override
+    {
+        Pet* pet = bot->GetPet();
+        return sPlayerbotAIConfig.SmartPetAbilities && pet && pet->GetGUID() != configured;
+    }
+
+    bool Execute(Event /*event*/) override
+    {
+        static std::set<std::string> const manual = {"Seduction", "Spell Lock", "Gnaw", "Cower", "Phase Shift",
+                                                     "Lesser Invisibility", "Prowl"};
+        Pet* pet = bot->GetPet();
+        for (auto const& [id, spell] : pet->m_spells)
+        {
+            SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+            if (spell.state == PETSPELL_REMOVED || !info || info->IsPassive() || !info->IsAutocastable())
+                continue;
+            pet->ToggleAutocast(info, !manual.count(info->SpellName[0]));
+        }
+        configured = pet->GetGUID();
+        return true;
+    }
+
+private:
+    ObjectGuid configured;
+};
+
+class PetSpellCastTrigger : public Trigger
+{
+public:
+    PetSpellCastTrigger(PlayerbotAI* botAI, std::string const name, char const* spell)
+        : Trigger(botAI, name), spell(spell)
+    {
+    }
+
+protected:
+    uint32 Ready() { return sPlayerbotAIConfig.SmartPetAbilities ? ai::pet::ReadySpell(bot->GetPet(), spell) : 0; }
+    char const* spell;
+};
+
+class PetSpellLockTrigger : public PetSpellCastTrigger
+{
+public:
+    PetSpellLockTrigger(PlayerbotAI* botAI) : PetSpellCastTrigger(botAI, "pet spell lock", "Spell Lock") {}
+    bool IsActive() override { return Ready() && ai::pet::CastingEnemy(botAI, bot->GetPet(), 30.0f); }
+};
+
+class PetGnawTrigger : public PetSpellCastTrigger
+{
+public:
+    PetGnawTrigger(PlayerbotAI* botAI) : PetSpellCastTrigger(botAI, "pet gnaw", "Gnaw") {}
+    bool IsActive() override { return Ready() && ai::pet::CastingEnemy(botAI, bot->GetPet(), 5.0f); }
+};
+
+class PetSeductionTrigger : public PetSpellCastTrigger
+{
+public:
+    PetSeductionTrigger(PlayerbotAI* botAI) : PetSpellCastTrigger(botAI, "pet seduction", "Seduction") {}
+    bool IsActive() override
+    {
+        return Ready() && bot->IsInCombat() && ai::pet::SeductionTarget(botAI, bot->GetPet());
+    }
+};
+
+class PetSpellCastAction : public Action
+{
+public:
+    PetSpellCastAction(PlayerbotAI* botAI, std::string const name, char const* spell)
+        : Action(botAI, name), spell(spell)
+    {
+    }
+
+    bool Execute(Event /*event*/) override
+    {
+        Pet* pet = bot->GetPet();
+        uint32 const id = ai::pet::ReadySpell(pet, spell);
+        Unit* target = id ? Target(pet) : nullptr;
+        return target && pet->CastSpell(target, id, false) == SPELL_CAST_OK;
+    }
+
+protected:
+    virtual Unit* Target(Pet* pet) = 0;
+    char const* spell;
+};
+
+class PetSpellLockAction : public PetSpellCastAction
+{
+public:
+    PetSpellLockAction(PlayerbotAI* botAI) : PetSpellCastAction(botAI, "pet spell lock", "Spell Lock") {}
+
+protected:
+    Unit* Target(Pet* pet) override { return ai::pet::CastingEnemy(botAI, pet, 30.0f); }
+};
+
+class PetGnawAction : public PetSpellCastAction
+{
+public:
+    PetGnawAction(PlayerbotAI* botAI) : PetSpellCastAction(botAI, "pet gnaw", "Gnaw") {}
+
+protected:
+    Unit* Target(Pet* pet) override { return ai::pet::CastingEnemy(botAI, pet, 5.0f); }
+};
+
+class PetSeductionAction : public PetSpellCastAction
+{
+public:
+    PetSeductionAction(PlayerbotAI* botAI) : PetSpellCastAction(botAI, "pet seduction", "Seduction") {}
+
+protected:
+    Unit* Target(Pet* pet) override { return ai::pet::SeductionTarget(botAI, pet); }
+};
+
+#endif
diff --git a/src/Ai/Base/Strategy/RacialsStrategy.cpp b/src/Ai/Base/Strategy/RacialsStrategy.cpp
index 1d45d78b..9ab29dad 100644
--- a/src/Ai/Base/Strategy/RacialsStrategy.cpp
+++ b/src/Ai/Base/Strategy/RacialsStrategy.cpp
@@ -105,4 +105,14 @@ void RacialsStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
 
     triggers.push_back(new TriggerNode(
         "generic boost", { NextAction("use trinket", ACTION_NORMAL + 4) }));
+
+    // Pet abilities ride on "racials" because every bot runs it in combat (PetAbilities.h, opt-in)
+    uint8 const cls = bot->getClass();
+    if (cls == CLASS_WARLOCK || cls == CLASS_HUNTER || cls == CLASS_DEATH_KNIGHT)
+    {
+        triggers.push_back(new TriggerNode("often", { NextAction("pet autocast setup", ACTION_NORMAL) }));
+        triggers.push_back(new TriggerNode("pet spell lock", { NextAction("pet spell lock", ACTION_INTERRUPT + 2) }));
+        triggers.push_back(new TriggerNode("pet gnaw", { NextAction("pet gnaw", ACTION_INTERRUPT + 2) }));
+        triggers.push_back(new TriggerNode("pet seduction", { NextAction("pet seduction", ACTION_INTERRUPT + 1) }));
+    }
 }
