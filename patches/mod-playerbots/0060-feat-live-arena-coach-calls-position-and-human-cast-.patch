+uint32 AbOrderAction::OpeningOrder(Player* bot, Battleground* bg)
+{
+    std::vector<uint32> const& bases = bot->GetBgTeamId() == TEAM_HORDE ? sPlayerbotAIConfig.AbTrioBasesHorde
+                                                                         : sPlayerbotAIConfig.AbTrioBasesAlliance;
+    Group* group = bot->GetGroup();
+    uint8 const subgroup = group ? group->GetMemberGroup(bot->GetGUID()) : MAX_RAID_SUBGROUPS;
+    bool const hasBase = subgroup < bases.size() && bases[subgroup] < BG_AB_DYNAMIC_NODES_COUNT;
+    return (bg->GetInstanceID() << 3) | (hasBase ? bases[subgroup] + 1 : 0);
+}
+
+bool AbOrderAction::WaitsForTrio(Player* bot, Battleground* bg, uint32 order)
+{
+    float constexpr nodeRange = 60.0f;
+
+    int const node = int(order & 7) - 1;
+    Group* group = bot->GetGroup();
+    if (!sPlayerbotAIConfig.AbTrioRegroup || node < 0 || (order >> 3) != bg->GetInstanceID() || !group)
+        return false;
+
+    GameObject* flag = bg->GetBGObject(node * BG_AB_OBJECTS_PER_NODE);
+    if (!flag || bot->IsWithinDist(flag, nodeRange))
+        return false;  // holding or taking the node comes first
+
+    // ponytail: holds wherever it stands, even mid-road; a dead member is back within one 30 s wave
+    uint8 const subgroup = group->GetMemberGroup(bot->GetGUID());
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (member && member != bot && !member->IsAlive() && PlayerbotsMgr::instance().GetPlayerbotAI(member) &&
+            group->GetMemberGroup(member->GetGUID()) == subgroup)
+            return true;
+    }
+
+    return false;
+}
+
+uint32 AbOrderAction::NodeToPlay(Player* bot, BattlegroundAB* ab, uint32 node)
+{
+    bool const horde = bot->GetBgTeamId() == TEAM_HORDE;
+    uint32 const home = horde ? BG_AB_NODE_FARM : BG_AB_NODE_STABLES;
+    uint8 const held = horde ? BG_AB_NODE_STATE_HORDE_OCCUPIED : BG_AB_NODE_STATE_ALLY_OCCUPIED;
+
+    Group* group = bot->GetGroup();
+    if (!sPlayerbotAIConfig.AbTrioHomeGuard || node != home || !group || ab->GetCapturePointInfo(node)._state != held)
+        return node;
+
+    // ponytail: also overrides an explicit "ab tN <home>" from the raid while home is held and quiet
+    bool isGuard = true;
+    uint8 const subgroup = group->GetMemberGroup(bot->GetGUID());
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (member && member != bot && member->IsAlive() && group->GetMemberGroup(member->GetGUID()) == subgroup &&
+            member->GetGUID() < bot->GetGUID())
+            isGuard = false;
+    }
+
+    if (isGuard)
+        return node;
+
+    uint32 target = node;
+    float closest = FLT_MAX;
+    for (uint32 other = 0; other < BG_AB_DYNAMIC_NODES_COUNT; ++other)
+    {
+        GameObject* flag = ab->GetBGObject(other * BG_AB_OBJECTS_PER_NODE);
+        if (!flag || ab->GetCapturePointInfo(other)._state == held || bot->GetDistance(flag) >= closest)
+            continue;
+
+        closest = bot->GetDistance(flag);
+        target = other;
+    }
+
+    return target;
+}
+
+Player* AbOrderAction::TrioHuman(Player* bot)
+{
+    Group* group = bot->GetGroup();
+    if (!sPlayerbotAIConfig.AbTrioFollowHuman || !group)
+        return nullptr;
+
+    uint8 const subgroup = group->GetMemberGroup(bot->GetGUID());
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (member && member != bot && IsRealPlayer(member) && member->IsAlive() && member->IsInWorld() &&
+            member->GetMapId() == bot->GetMapId() && group->GetMemberGroup(member->GetGUID()) == subgroup)
+            return member;
+    }
+
+    return nullptr;
+}
