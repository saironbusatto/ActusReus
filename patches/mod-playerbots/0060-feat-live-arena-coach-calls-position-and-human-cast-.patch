+    // At most once per arena and second, whichever bot acts first
+    inline bool PositionLogDue(uint32 instance, uint32 second)
+    {
+        static std::mutex lock;
+        static std::unordered_map<uint32, uint32> last;
+        std::lock_guard<std::mutex> guard(lock);
+        if (last.size() > 1000)  // finished arenas are never erased one by one
+            last.clear();
+        uint32& seen = last[instance];
+        if (seen == second)
+            return false;
+        seen = second;
+        return true;
+    }
+
+    // p1,ms,instance,map, then per player in the arena (humans too): guid,x,y,z,orientation,target,casting spell.
+    // What the v4 lines cannot show: geometry, who each ally is hitting and what is being cast.
+    inline void LogArenaPositions(Player* bot)
+    {
+        Battleground* bg = bot->GetBattleground();
+        uint32 const ms = GameTime::GetGameTimeMS().count();
+        if (!bg || !PositionLogDue(bot->GetInstanceId(), ms / 1000))
+            return;
+
+        std::string line = fmt::format("p1,{},{},{}", ms, bot->GetInstanceId(), bot->GetMapId());
+        for (auto const& itr : bg->GetPlayers())
+        {
+            Player* p = itr.second;
+            if (!p || !p->IsInWorld() || p->GetMap() != bot->GetMap())
+                continue;
+            Spell const* spell = p->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+            if (!spell)
+                spell = p->GetCurrentSpell(CURRENT_CHANNELED_SPELL);
+            line += fmt::format(",{},{:.1f},{:.1f},{:.1f},{:.2f},{},{}", p->GetGUID().GetCounter(), p->GetPositionX(),
+                                p->GetPositionY(), p->GetPositionZ(), p->GetOrientation(),
