new file mode 100644
index 00000000..d80c99cf
--- /dev/null
+++ b/src/Ai/Base/Value/AbFocusTargetValue.cpp
@@ -0,0 +1,107 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "AbFocusTargetValue.h"
+
+#include <limits>
+#include <vector>
+
+#include "Battleground.h"
+#include "BattlegroundAB.h"
+#include "PlayerbotAIConfig.h"
+#include "Playerbots.h"
+
+namespace
+{
+    float constexpr FOCUS_NODE_RADIUS = 50.0f;  // same range as the defender callouts
+    float constexpr FOCUS_ATTACK_RANGE = 40.0f;
+    float constexpr ARMOR_PER_EXTRA_HEALTH = 10000.0f;  // roughly cloth x1.3, plate x3
+    float constexpr HEALED_FACTOR = 1.5f;
+    float constexpr CLASH_RANGE = 30.0f;  // Bloodlust reaches the raid within 40 yd; keep the fight inside it
+    uint32 constexpr CLASH_MIN_ALLIES = 4;
+    uint32 constexpr CLASH_MIN_ENEMIES = 3;
+
+    GameObject* NearestFlag(Battleground* bg, Player* bot)
+    {
+        for (uint32 node = 0; node < BG_AB_DYNAMIC_NODES_COUNT; ++node)
+            if (GameObject* flag = bg->GetBGObject(node * BG_AB_OBJECTS_PER_NODE))
+                if (bot->IsWithinDist(flag, FOCUS_NODE_RADIUS))
+                    return flag;
+
+        return nullptr;
+    }
+
+    float EffectiveHealth(Player* enemy, std::vector<Player*> const& healers)
+    {
+        float health = enemy->GetHealth() * (1.0f + enemy->GetArmor() / ARMOR_PER_EXTRA_HEALTH);
+        for (Player* healer : healers)
+            if (healer != enemy && healer->IsWithinDist(enemy, FOCUS_ATTACK_RANGE))
+                return health * HEALED_FACTOR;
+
+        return health;
+    }
+}
+
+bool AbClashReady(Player* bot)
+{
+    Battleground* bg = bot->GetBattleground();
+    if (!sPlayerbotAIConfig.AbFocusTargets || !bg || bg->GetBgTypeID() != BATTLEGROUND_AB)
+        return true;
+
+    uint32 allies = 0;
+    uint32 enemies = 0;
+    for (auto const& [guid, player] : bg->GetPlayers())
+        if (player && player != bot && player->IsAlive() && bot->IsWithinDist(player, CLASH_RANGE))
+            ++(player->GetBgTeamId() == bot->GetBgTeamId() ? allies : enemies);
+
+    return allies >= CLASH_MIN_ALLIES && enemies >= CLASH_MIN_ENEMIES;
+}
+
+Unit* AbFocusTargetValue::Calculate()
+{
+    if (!sPlayerbotAIConfig.AbFocusTargets || PlayerbotAI::IsHeal(bot))
+        return nullptr;
+
+    Battleground* bg = bot->GetBattleground();
+    if (!bg || bg->GetBgTypeID() != BATTLEGROUND_AB || bg->GetStatus() != STATUS_IN_PROGRESS)
+        return nullptr;
+
+    GameObject* flag = NearestFlag(bg, bot);
+    if (!flag)
+        return nullptr;  // on the road: the rules keep targeting
+
+    std::vector<Player*> enemies;
+    std::vector<Player*> healers;
+    for (auto const& [guid, player] : bg->GetPlayers())  // at most 30 players in Arathi Basin
+    {
+        if (!player || !player->IsAlive() || player->GetBgTeamId() == bot->GetBgTeamId() ||
+            !player->IsWithinDist(flag, FOCUS_NODE_RADIUS))
+            continue;
+
+        enemies.push_back(player);
+        if (PlayerbotAI::IsHeal(player) && !player->HasBreakableByDamageCrowdControlAura())
+            healers.push_back(player);
+    }
+
+    Player* best = nullptr;
+    float bestHealth = std::numeric_limits<float>::max();
+    for (Player* enemy : enemies)
+    {
+        if (enemy->HasAuraType(SPELL_AURA_SCHOOL_IMMUNITY) || enemy->HasBreakableByDamageCrowdControlAura() ||
+            !bot->CanSeeOrDetect(enemy) || !bot->IsWithinDist(enemy, FOCUS_ATTACK_RANGE) ||
+            !bot->IsWithinLOSInMap(enemy))
+            continue;
+
+        float const health = EffectiveHealth(enemy, healers);
+        if (health < bestHealth || (best && health == bestHealth && enemy->GetGUID() < best->GetGUID()))
+        {
+            best = enemy;
+            bestHealth = health;
+        }
+    }
+
+    return best;
+}
