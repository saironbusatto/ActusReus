+    struct CoachCall
+    {
+        uint32 focus = 0;  // player guid counters, 0 = no call
+        uint32 cc = 0;
+    };
+
+    // The coach's latest calls by bot guid. At most every 250 ms one map thread re-reads the file; a file older than
+    // 3 s counts as empty, so a stopped coach hands the bots back to the rules.
+    class CoachCalls
+    {
+    public:
+        using CallMap = std::unordered_map<uint32, CoachCall>;
+
+        static CoachCalls& Instance()
+        {
+            static CoachCalls instance;
+            return instance;
+        }
+
+        std::shared_ptr<CallMap const> Get(std::string const& path)
+        {
+            uint64 const now = GameTime::GetGameTimeMS().count();
+            uint64 last = lastCheck.load(std::memory_order_relaxed);
+            if (now - last >= 250 && lastCheck.compare_exchange_strong(last, now))
+                std::atomic_store(&calls, Read(path));
+            return std::atomic_load(&calls);
+        }
+
+    private:
+        // ponytail: a blocking read on a map thread, one short line per bot; opt-in and only with a coach running
+        static std::shared_ptr<CallMap const> Read(std::string const& path)
+        {
+            auto map = std::make_shared<CallMap>();
+            std::error_code ec;
+            auto const mtime = std::filesystem::last_write_time(path, ec);
+            if (ec || std::filesystem::file_time_type::clock::now() - mtime > std::chrono::seconds(3))
+                return map;
+
+            std::ifstream file(path);
+            uint32 guid = 0;
+            CoachCall call;
+            while (file >> guid >> call.focus >> call.cc)
+                (*map)[guid] = call;
+            return map;
+        }
+
+        std::atomic<uint64> lastCheck{0};
+        std::shared_ptr<CallMap const> calls = std::make_shared<CallMap>();
+    };
+
+    // The coach's call for a bot of a Playerbots.ArenaCoachTeams team
+    inline CoachCall CoachCallFor(Player* bot)
+    {
+        if (!bot->InArena())
+            return {};
+        MlPolicies& p = MlPolicies::Instance();
+        p.Refresh();
+        auto const s = p.Settings();
+        bool coached = false;
+        for (uint8 slot = 0; slot < 3; ++slot)  // 2v2, 3v3, 5v5 team slots
+            coached = coached || s->coach.count(bot->GetArenaTeamId(slot));
+        if (!coached || s->coachFile.empty())
+            return {};
+
+        auto const calls = CoachCalls::Instance().Get(s->coachFile);
+        auto const it = calls->find(bot->GetGUID().GetCounter());
+        return it == calls->end() ? CoachCall{} : it->second;
+    }
+
+    // An enemy a call can use right now: alive, seen, in line of sight within 40 yd and not immune
+    inline Player* CoachEnemy(Player* bot, uint32 guid)
+    {
+        if (!guid)
+            return nullptr;
+        Player* enemy = ObjectAccessor::FindPlayer(ObjectGuid::Create<HighGuid::Player>(guid));
+        return enemy && enemy->IsInWorld() && enemy->GetMap() == bot->GetMap() && enemy->IsAlive() &&
+                       bot->IsHostileTo(enemy) && bot->CanSeeOrDetect(enemy) && bot->IsWithinDist(enemy, 40.0f) && bot->IsWithinLOSInMap(enemy) &&
+                       !enemy->HasAuraType(SPELL_AURA_SCHOOL_IMMUNITY)
+                   ? enemy
+                   : nullptr;
+    }
+
+    // Who the coach wants this bot to crowd-control, for every "cc target" of the class; nullptr leaves it to the rules
+    inline Unit* CoachCcTarget(PlayerbotAI* botAI)
+    {
+        Player* bot = botAI->GetBot();
+        return CoachEnemy(bot, CoachCallFor(bot).cc);
+    }
